                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "strength": {
                  "enum": [
                    "required",
                    "preferred",
                    "optional"
                  ]
                }
              },
              "required": [
                "from",
                "to",
                "kind",
                "readiness",
                "protocol",
                "port",
                "controlled_interface",
                "dataset_id",
                "strength"
              ]
            },
            "minItems": 0,
            "maxItems": 500
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "owner_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "workload_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "requirements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
                      },
                      "strength": {
                        "enum": [
                          "required",
                          "preferred",
                          "optional"
                        ]
                      },
                      "value": {
                        "type": [
                          "string",
                          "integer",
                          "boolean"
                        ],
                        "maxLength": 2048
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
