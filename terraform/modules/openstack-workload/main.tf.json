{
  "//": "Original implementation, increment 01. RESTRICTED QUARANTINE ONLY. Native provider validation and target tests are outstanding.",
  "terraform": {
    "required_version": ">= 1.7.0, < 2.0.0",
    "required_providers": {
      "openstack": {
        "source": "terraform-provider-openstack/openstack",
        "version": "= 3.4.0"
      }
    }
  },
  "variable": {
    "tenant_key": {
      "type": "string",
      "description": "Stable tenant identifier",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,23}$\", var.tenant_key))}",
          "error_message": "Invalid value for Stable tenant identifier."
        }
      ]
    },
    "domain_key": {
      "type": "string",
      "description": "Stable domain identifier",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[A-Za-z][A-Za-z0-9-]{1,23}$\", var.domain_key))}",
          "error_message": "Invalid value for Stable domain identifier."
        }
      ]
    },
    "allow_restricted_build": {
      "type": "bool",
      "description": "Explicit operator opt-in for an authorized non-production build",
      "nullable": false,
      "default": false
    },
    "test_authorization_ref": {
      "type": "string",
      "description": "Reference to separately issued test-scope authorization",
      "nullable": false
    },
    "workload_key": {
      "type": "string",
      "description": "Owned workload identity",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,40}$\", var.workload_key))}",
          "error_message": "Invalid value for Owned workload identity."
        }
      ]
    },
    "boot_disk_gib": {
      "type": "number",
      "description": "Requested boot disk GiB; must be at least image/template size",
      "nullable": false,
      "default": 40,
      "validation": [
        {
          "condition": "${var.boot_disk_gib >= 1 && floor(var.boot_disk_gib) == var.boot_disk_gib}",
          "error_message": "Invalid value for Requested boot disk GiB; must be at least image/template size."
        }
      ]
    },
    "data_disk_gib": {
      "type": "number",
      "description": "Owned optional data disk GiB; zero omits",
      "nullable": false,
      "default": 0,
      "validation": [
        {
          "condition": "${var.data_disk_gib >= 0 && floor(var.data_disk_gib) == var.data_disk_gib}",
          "error_message": "Invalid value for Owned optional data disk GiB; zero omits."
        }
      ]
    },
    "accepted_quarantine_ref": {
      "type": "string",
      "description": "Scoped independently reviewed network/policy/placement handoff reference",
      "nullable": false
    },
    "network_id": {
      "type": "string",
      "description": "Accepted quarantine network UUID",
      "nullable": false
    },
    "subnet_id": {
      "type": "string",
      "description": "Accepted quarantine subnet UUID",
      "nullable": false
    },
    "security_group_id": {
      "type": "string",
      "description": "Accepted no-user-flow group UUID",
      "nullable": false
    },
    "ipv4_address": {
      "type": "string",
      "description": "Authoritatively reserved IPv4 address",
      "nullable": false
    },
    "image_id": {
      "type": "string",
      "description": "Approved Glance image UUID",
      "nullable": false
    },
    "flavor_id": {
      "type": "string",
      "description": "Approved flavor ID matching requested capacity and placement",
      "nullable": false
    },
    "compute_availability_zone": {
      "type": "string",
      "description": "Accepted Nova availability zone",
      "nullable": false
    },
    "storage_availability_zone": {
      "type": "string",
      "description": "Accepted Cinder availability zone",
      "nullable": false
    },
    "volume_type": {
      "type": "string",
      "description": "Accepted storage/encryption type",
      "nullable": false
    }
  },
  "resource": {
    "openstack_networking_port_v2": {
      "workload": {
        "name": "${var.workload_key}-port",
        "network_id": "${var.network_id}",
        "admin_state_up": false,
        "port_security_enabled": true,
        "security_group_ids": [
          "${var.security_group_id}"
        ],
        "fixed_ip": [
          {
            "subnet_id": "${var.subnet_id}",
            "ip_address": "${var.ipv4_address}"
          }
        ],
        "lifecycle": {
          "prevent_destroy": true,
          "precondition": [
            {
              "condition": "${var.allow_restricted_build && length(trimspace(var.test_authorization_ref)) > 0}",
              "error_message": "Restricted build is not opted in or the external test-authorization reference is missing. No production activation is implemented."
            },
            {
              "condition": "${length(trimspace(var.accepted_quarantine_ref)) > 0}",
              "error_message": "A separately reviewed quarantine/placement handoff is required. A reference string is not proof of approval."
            }
          ]
        }
      }
    },
    "openstack_blockstorage_volume_v3": {
      "boot": {
        "name": "${var.workload_key}-boot",
        "size": "${var.boot_disk_gib}",
        "image_id": "${var.image_id}",
        "volume_type": "${var.volume_type}",
        "availability_zone": "${var.storage_availability_zone}",
        "metadata": {
          "tenant_key": "${var.tenant_key}",
          "domain_key": "${var.domain_key}",
          "workload_key": "${var.workload_key}"
        },
        "lifecycle": {
          "prevent_destroy": true,
          "precondition": [
            {
              "condition": "${var.allow_restricted_build && length(trimspace(var.test_authorization_ref)) > 0}",
              "error_message": "Restricted build is not opted in or the external test-authorization reference is missing. No production activation is implemented."
            },
            {
              "condition": "${length(trimspace(var.accepted_quarantine_ref)) > 0}",
              "error_message": "A separately reviewed quarantine/placement handoff is required. A reference string is not proof of approval."
            }
          ]
        }
      },
      "data": {
        "count": "${var.data_disk_gib > 0 ? 1 : 0}",
        "name": "${var.workload_key}-data",
        "size": "${var.data_disk_gib}",
        "volume_type": "${var.volume_type}",
        "availability_zone": "${var.storage_availability_zone}",
        "metadata": {
          "tenant_key": "${var.tenant_key}",
          "domain_key": "${var.domain_key}",
          "workload_key": "${var.workload_key}"
        },
        "lifecycle": {
          "prevent_destroy": true,
          "precondition": [
            {
              "condition": "${var.allow_restricted_build && length(trimspace(var.test_authorization_ref)) > 0}",
              "error_message": "Restricted build is not opted in or the external test-authorization reference is missing. No production activation is implemented."
            },
            {
              "condition": "${length(trimspace(var.accepted_quarantine_ref)) > 0}",
              "error_message": "A separately reviewed quarantine/placement handoff is required. A reference string is not proof of approval."
            }
          ]
        }
      }
    },
    "openstack_compute_instance_v2": {
      "workload": {
        "name": "${var.workload_key}",
        "flavor_id": "${var.flavor_id}",
        "availability_zone": "${var.compute_availability_zone}",
        "power_state": "shutoff",
        "stop_before_destroy": true,
        "metadata": {
          "tenant_key": "${var.tenant_key}",
          "domain_key": "${var.domain_key}",
          "workload_key": "${var.workload_key}"
        },
        "network": [
          {
            "port": "${openstack_networking_port_v2.workload.id}"
          }
        ],
        "block_device": [
          {
            "uuid": "${openstack_blockstorage_volume_v3.boot.id}",
            "source_type": "volume",
            "destination_type": "volume",
            "boot_index": 0,
            "delete_on_termination": false
          }
        ],
        "lifecycle": {
          "prevent_destroy": true,
          "precondition": [
            {
              "condition": "${var.allow_restricted_build && length(trimspace(var.test_authorization_ref)) > 0}",
              "error_message": "Restricted build is not opted in or the external test-authorization reference is missing. No production activation is implemented."
            },
            {
              "condition": "${length(trimspace(var.accepted_quarantine_ref)) > 0}",
              "error_message": "A separately reviewed quarantine/placement handoff is required. A reference string is not proof of approval."
            }
          ]
        }
      }
    },
    "openstack_compute_volume_attach_v2": {
      "data": {
        "count": "${var.data_disk_gib > 0 ? 1 : 0}",
        "instance_id": "${openstack_compute_instance_v2.workload.id}",
        "volume_id": "${openstack_blockstorage_volume_v3.data[0].id}",
        "lifecycle": {
          "prevent_destroy": true,
          "precondition": [
            {
              "condition": "${var.allow_restricted_build && length(trimspace(var.test_authorization_ref)) > 0}",
              "error_message": "Restricted build is not opted in or the external test-authorization reference is missing. No production activation is implemented."
            },
            {
              "condition": "${length(trimspace(var.accepted_quarantine_ref)) > 0}",
              "error_message": "A separately reviewed quarantine/placement handoff is required. A reference string is not proof of approval."
            }
          ]
        }
      }
    }
  },
  "output": {
    "server_id": {
      "value": "${openstack_compute_instance_v2.workload.id}"
    },
    "port_id": {
      "value": "${openstack_networking_port_v2.workload.id}"
    },
    "boot_volume_id": {
      "value": "${openstack_blockstorage_volume_v3.boot.id}"
    },
    "data_volume_ids": {
      "value": "${openstack_blockstorage_volume_v3.data[*].id}"
    },
    "delivery_state": {
      "value": "PREPARED_NOT_QUALIFIED_NOT_SERVICE_READY"
    }
  }
}
