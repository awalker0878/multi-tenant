    "/v1/tenants/{tenant}/approvals/{approval}/validations": {
      "post": {
        "operationId": "validateApproval",
        "parameters": [
          {
            "in": "header",
            "name": "X-Console-Session",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "description": "Opaque server-held federated user session. Body actor/role values are never authority."
          },
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "approval",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; Cache-Control: no-store, private",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalValidation"
                }
              }
            }
          },
          "401": {
            "description": "Invalid workload or user session"
          },
          "403": {
            "description": "Current scope/action denied"
          },
          "404": {
            "description": "Unknown resource or no membership"
          },
          "409": {
            "description": "Revision, retry, binding or transition conflict"
          },
          "422": {
            "description": "Invalid input"
          },
          "503": {
            "description": "Required authority unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "plan_id",
                  "plan_revision",
                  "plan_digest",
                  "action",
                  "scope"
                ],
                "properties": {
                  "plan_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "plan_revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "plan_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "action": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "scope": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "site_id",
                      "environment",
                      "resource_id"
                    ],
                    "properties": {
                      "site_id": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "environment": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "resource_id": {
                        "type": "string",
                        "maxLength": 128
                      }
                    }
                  }
                }
              }
            }
          }
        }
