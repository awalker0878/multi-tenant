{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declared cross-platform feature map and Console owner requirements, not installed eligibility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "status",
    "source_manifest",
    "source_crosswalk",
    "rules",
    "features",
    "operator_requirements",
    "directions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "proposed_not_qualified"
    },
    "source_manifest": {
      "const": "contracts/capabilities/migration-collection-manifest-v1.json"
    },
    "source_crosswalk": {
      "const": "contracts/capabilities/migration-field-crosswalk-v1.json"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criticality",
        "native",
        "operator",
        "optional",
        "decision"
      ],
      "properties": {
        "criticality": {
          "type": "string",
          "minLength": 25
        },
        "native": {
          "type": "string",
          "minLength": 25
        },
        "operator": {
          "type": "string",
          "minLength": 25
        },
        "optional": {
          "type": "string",
          "minLength": 25
        },
        "decision": {
          "type": "string",
          "minLength": 25
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "mapping",
          "criticality",
          "crosswalk_groups",
          "operator_attributes",
          "qualification",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$"
          },
          "label": {
            "type": "string",
            "minLength": 4
          },
          "mapping": {
            "enum": [
              "version_qualified",
              "qualified_adapter",
              "normalize_with_recheck",
              "owner_and_native",
              "operator_and_native",
              "conditional_optional"
            ]
          },
          "criticality": {
            "enum": [
              "critical",
              "optional"
            ]
          },
          "crosswalk_groups": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "operator_attributes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "qualification": {
            "const": "unqualified"
          },
          "notes": {
            "type": "string",
            "minLength": 30
          }
        }
      }
    },
    "operator_requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attribute_id",
          "feature_id",
          "criticality",
          "condition",
          "max_age_seconds",
          "review_field",
          "readiness_field",
          "evidence_owner",
          "verification"
        ],
        "properties": {
          "attribute_id": {
            "type": "string"
          },
          "feature_id": {
            "type": "string"
          },
          "criticality": {
            "enum": [
              "critical",
              "optional"
            ]
          },
          "condition": {
            "type": "string"
          },
          "max_age_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "review_field": {
            "type": [
              "string",
              "null"
            ]
          },
          "readiness_field": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_owner": {
            "enum": [
              "operator",
              "independent",
              "optional_e4_omission"
            ]
          },
          "verification": {
            "enum": [
              "approved_owner_reference",
              "independent_verification",
              "e4_approved_suppression"
            ]
          }
        }
      }
    },
    "directions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "target",
          "features"
        ],
        "properties": {
          "source": {
            "enum": [
              "vmware",
              "ahv",
              "openstack"
            ]
          },
          "target": {
            "enum": [
              "vmware",
              "ahv",
              "openstack"
            ]
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "feature_id",
                "source_attributes",
                "target_attributes",
                "mapping_proposal",
                "admission"
              ],
              "properties": {
                "feature_id": {
                  "type": "string"
                },
                "source_attributes": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "target_attributes": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "mapping_proposal": {
                  "enum": [
                    "no_direct_field_qualified_alternative_required",
                    "normalize_data_revalidate",
                    "optional_requires_e4_if_omitted",
                    "operator_plus_native_proof",
                    "qualified_adapter_required"
                  ]
                },
                "admission": {
                  "const": "unknown_requires_installed_qualification"
                }
              }
            }
          }
        }
      }
    }
  }
}
