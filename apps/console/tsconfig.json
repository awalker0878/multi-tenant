{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": false,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.vue",
    "tests/browser/**/*.ts",
    "tests/browser-p02/**/*.ts",
    "playwright.p02.config.ts",
    "playwright.config.ts",
    "vite.config.ts",
    "tests/architecture/**/*.ts"
  ]
}
