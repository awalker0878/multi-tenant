                      "type": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "spec_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "category_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "maxItems": 64,
                        "uniqueItems": true
                      },
                      "address_group_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "maxItems": 64,
                        "uniqueItems": true
                      },
                      "service_group_ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        "maxItems": 64,
                        "uniqueItems": true
                      },
                      "reference_resolution": {
                        "enum": [
                          "catalogue_ids_only",
                          "unresolved"
                        ]
                      }
