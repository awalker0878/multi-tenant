              }
            },
            "holds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "independent_e3_e4_qualification": {
              "const": false
            },
            "native_write_authorized": {
              "const": false
            },
            "coverage_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "expires_at": {
