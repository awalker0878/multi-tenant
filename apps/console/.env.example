APP_ENV=local
APP_KEY=
APP_URL=http://127.0.0.1:8000
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=false
# Set database sessions and secure cookies for the deployed HTTPS workspace.
DB_HOST=unconfigured.invalid
DB_PASSWORD_FILE=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/secrets/postgres-ca.crt
GOVERNANCE_URL=
GOVERNANCE_CA_FILE=
CONSOLE_CREDENTIAL_FILE=
CATALOGUE_URL=
CATALOGUE_CA_FILE=
CATALOGUE_CONSOLE_CREDENTIAL_FILE=
