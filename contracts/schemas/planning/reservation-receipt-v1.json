{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reservation_id": {
      "type": "string",
      "format": "uuid"
    },
    "receipt_id": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "amount": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "type": "object"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "reserved",
        "confirmed",
        "released",
        "denied",
        "outcome_unknown"
      ]
    },
    "in_use": {
      "type": "boolean"
    },
    "observed_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "reservation_id",
    "receipt_id",
    "owner",
    "kind",
    "amount",
    "scope",
    "plan_digest",
    "state",
    "in_use",
    "observed_at",
    "expires_at"
  ]
}
