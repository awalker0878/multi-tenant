* text=auto eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.hcl text eol=lf
*.tf text eol=lf
*.j2 text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.docx binary
*.xlsx binary
*.pdf binary
*.png binary
*.jpg binary
*.zip binary
# Frozen evidence and CSV schedules retain their original byte/line-ending identity.
*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
reference/** -text
quality/** -text
evidence/imported/** -text
