        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "guest": {
                  "const": "appliance"
                }
              }
            },
            "then": {
              "properties": {
                "constraints": {
                  "properties": {
                    "guest_mutation": {
                      "const": "prohibited"
                    }
                  }
                }
              }
            }
          }
        ]
