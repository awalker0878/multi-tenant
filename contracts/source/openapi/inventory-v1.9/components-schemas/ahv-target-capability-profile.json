      "security_references": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity_groups": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "extId": {
                  "type": "string",
                  "format": "uuid"
                },
                "native_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "resolution": {
                  "const": "definition_only"
                }
              },
              "required": [
                "extId",
                "native_sha256",
                "resolution"
              ]
            }
          },
          "address_groups": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "extId": {
                  "type": "string",
                  "format": "uuid"
                },
                "native_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "resolution": {
                  "const": "definition_only"
                }
              },
              "required": [
                "extId",
                "native_sha256",
                "resolution"
              ]
            }
          },
          "service_groups": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "extId": {
                  "type": "string",
                  "format": "uuid"
                },
                "native_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "resolution": {
                  "const": "definition_only"
                }
              },
              "required": [
                "extId",
                "native_sha256",
                "resolution"
              ]
            }
          }
