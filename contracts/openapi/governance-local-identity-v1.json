    "/identity/setup": {
      "get": {
        "operationId": "readLocalSetup",
        "description": "Require the password change and current setup permission. This first slice does not implement external OIDC configuration or activation.",
        "responses": {
          "200": {
            "description": "Success. Responses use Cache-Control: no-store, private.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Setup"
                }
              }
            }
          },
          "401": {
            "description": "Denied, invalid input, throttled, or unavailable. No credential values are returned.",
            "content": {
