{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-hypervisor migration semantic field crosswalk v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "crosswalk_version",
    "status",
    "collection_manifest",
    "mapping_rules",
    "summary",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "crosswalk_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "declared_mapping_not_native_evidence"
    },
    "collection_manifest": {
      "const": "contracts/capabilities/migration-collection-manifest-v1.json"
    },
    "mapping_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_equivalent",
        "no_auto_security",
        "no_copy_native_ids",
        "freshness"
      ],
      "properties": {
        "no_equivalent": {
          "type": "string",
          "minLength": 30
        },
        "no_auto_security": {
          "type": "string",
          "minLength": 30
        },
        "no_copy_native_ids": {
          "type": "string",
          "minLength": 30
        },
        "freshness": {
          "type": "string",
          "minLength": 30
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groups",
        "shared_columns",
        "partial_columns",
        "platform_specific",
        "owner_common",
        "manifest_fields"
      ],
      "properties": {
        "groups": {
          "type": "integer",
          "minimum": 1
        },
        "shared_columns": {
          "type": "integer",
          "minimum": 0
        },
        "partial_columns": {
          "type": "integer",
          "minimum": 0
        },
        "platform_specific": {
          "type": "integer",
          "minimum": 0
        },
        "owner_common": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vmware",
            "ahv",
            "openstack"
          ],
          "properties": {
            "vmware": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "matched",
                "total"
              ],
              "properties": {
                "matched": {
                  "type": "integer",
                  "minimum": 1
                },
                "total": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "ahv": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "matched",
                "total"
              ],
              "properties": {
                "matched": {
                  "type": "integer",
                  "minimum": 1
                },
                "total": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "openstack": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "matched",
                "total"
              ],
              "properties": {
                "matched": {
                  "type": "integer",
                  "minimum": 1
                },
                "total": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_id",
          "scope",
          "relationship",
          "normalization",
          "platforms",
          "criticality",
          "maximum_age_seconds",
          "semantic_constraints",
          "qualification",
          "migration_policy"
        ],
        "properties": {
          "canonical_id": {
            "type": "string",
            "pattern": "^(source|target|owner)\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,8}$"
          },
          "scope": {
            "enum": [
              "source",
              "target",
              "owner"
            ]
          },
          "relationship": {
            "enum": [
              "normalize",
              "conditional",
              "platform_specific",
              "owner_common"
            ]
          },
          "normalization": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,90}$"
          },
          "platforms": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "vmware",
              "ahv",
              "openstack"
            ],
            "properties": {
              "vmware": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "manifest_attribute_ids",
                      "api_fields",
                      "owner_evidence_fields",
                      "methods",
                      "max_age_seconds",
                      "severity",
                      "conditions"
                    ],
                    "properties": {
                      "manifest_attribute_ids": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$"
                        }
                      },
                      "api_fields": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "items": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "owner_evidence_fields": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "items": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "methods": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "items": {
                          "enum": [
                            "native_get",
                            "native_list",
                            "derive",
                            "operator",
                            "probe",
                            "independent"
                          ]
                        }
                      },
                      "max_age_seconds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 86400
                      },
                      "severity": {
                        "enum": [
                          "critical",
                          "optional"
                        ]
                      },
                      "conditions": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^(always|cutover|when:[a-z][a-z0-9_]*)$"
                        }
                      }
                    }
                  }
                ]
              },
              "ahv": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "manifest_attribute_ids",
                      "api_fields",
                      "owner_evidence_fields",
                      "methods",
                      "max_age_seconds",
                      "severity",
                      "conditions"
                    ],
                    "properties": {
                      "manifest_attribute_ids": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$"
                        }
                      },
                      "api_fields": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "items": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "owner_evidence_fields": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "items": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "methods": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "items": {
                          "enum": [
                            "native_get",
                            "native_list",
                            "derive",
                            "operator",
                            "probe",
                            "independent"
                          ]
                        }
                      },
                      "max_age_seconds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 86400
                      },
                      "severity": {
                        "enum": [
                          "critical",
                          "optional"
                        ]
                      },
                      "conditions": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^(always|cutover|when:[a-z][a-z0-9_]*)$"
                        }
                      }
                    }
                  }
                ]
              },
              "openstack": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "manifest_attribute_ids",
                      "api_fields",
                      "owner_evidence_fields",
                      "methods",
                      "max_age_seconds",
                      "severity",
                      "conditions"
                    ],
                    "properties": {
                      "manifest_attribute_ids": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$"
                        }
                      },
                      "api_fields": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "items": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "owner_evidence_fields": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "items": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "methods": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "items": {
                          "enum": [
                            "native_get",
                            "native_list",
                            "derive",
                            "operator",
                            "probe",
                            "independent"
                          ]
                        }
                      },
                      "max_age_seconds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 86400
                      },
                      "severity": {
                        "enum": [
                          "critical",
                          "optional"
                        ]
                      },
                      "conditions": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^(always|cutover|when:[a-z][a-z0-9_]*)$"
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "criticality": {
            "enum": [
              "critical",
              "optional"
            ]
          },
          "maximum_age_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "semantic_constraints": {
            "type": "string",
            "minLength": 25,
            "maxLength": 700
          },
          "qualification": {
            "const": "not_qualified"
          },
          "migration_policy": {
            "enum": [
              "owner_evidence_required",
              "independent_qualification_required"
            ]
          }
        }
      }
    }
  }
}
