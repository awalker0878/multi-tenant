{
  "//": "Generated by scripts/build_wsd_compositions.py; restricted native composition.",
  "terraform": {
    "required_version": ">= 1.7.0, < 2.0.0",
    "required_providers": {
      "nutanix": {
        "source": "nutanix/nutanix",
        "version": "= 2.4.2"
      }
    }
  },
  "variable": {
    "tenant_key": {
      "type": "string",
      "description": "Stable tenant identifier",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,23}$\", var.tenant_key))}",
          "error_message": "Invalid value for Stable tenant identifier."
        }
      ]
    },
    "allow_restricted_build": {
      "type": "bool",
      "description": "Explicit operator opt-in for an authorized non-production build",
      "nullable": false,
      "default": false
    },
    "test_authorization_ref": {
      "type": "string",
      "description": "Reference to separately issued test-scope authorization",
      "nullable": false
    },
    "wsd_key": {
      "type": "string",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,40}$\", var.wsd_key))}",
          "error_message": "A stable WSD identity is required."
        }
      ]
    },
    "environment_key": {
      "type": "string",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,40}$\", var.environment_key))}",
          "error_message": "A stable environment/site identity is required."
        }
      ]
    },
    "site_key": {
      "type": "string",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,40}$\", var.site_key))}",
          "error_message": "A stable environment/site identity is required."
        }
      ]
    },
    "members": {
      "type": "map(object({domain_key = string, vcpu = optional(number, 2), memory_gib = optional(number, 4), boot_disk_gib = optional(number, 40), data_disk_gib = optional(number, 0), accepted_quarantine_ref = string, cluster_id = string, project_id = string, storage_container_id = string, image_id = string, subnet_id = string, security_category_id = string, ipv4_address = string, lifecycle_stage = optional(string, \"prepared\"), bootstrap_acceptance_ref = optional(string, \"\")}))",
      "nullable": false,
      "description": "workloads owned by this tenant/WSD; map keys are immutable native identities.",
      "validation": [
        {
          "condition": "${length(var.members) > 0}",
          "error_message": "An empty WSD scope is not an allocation or retirement request."
        }
      ]
    }
  },
  "module": {
    "member": {
      "source": "../../../modules/nutanix-workload",
      "for_each": "${var.members}",
      "allow_restricted_build": "${var.allow_restricted_build}",
      "tenant_key": "${var.tenant_key}",
      "test_authorization_ref": "${var.test_authorization_ref}",
      "workload_key": "${each.key}",
      "domain_key": "${each.value.domain_key}",
      "vcpu": "${each.value.vcpu}",
      "memory_gib": "${each.value.memory_gib}",
      "boot_disk_gib": "${each.value.boot_disk_gib}",
      "data_disk_gib": "${each.value.data_disk_gib}",
      "accepted_quarantine_ref": "${each.value.accepted_quarantine_ref}",
      "cluster_id": "${each.value.cluster_id}",
      "project_id": "${each.value.project_id}",
      "storage_container_id": "${each.value.storage_container_id}",
      "image_id": "${each.value.image_id}",
      "subnet_id": "${each.value.subnet_id}",
      "security_category_id": "${each.value.security_category_id}",
      "ipv4_address": "${each.value.ipv4_address}",
      "lifecycle_stage": "${each.value.lifecycle_stage}",
      "bootstrap_acceptance_ref": "${each.value.bootstrap_acceptance_ref}"
    }
  },
  "output": {
    "scope": {
      "value": {
        "tenant_key": "${var.tenant_key}",
        "wsd_key": "${var.wsd_key}",
        "platform": "nutanix",
        "phase": "workloads",
        "environment_key": "${var.environment_key}",
        "site_key": "${var.site_key}"
      }
    },
    "members": {
      "value": "${module.member}"
    },
    "delivery_state": {
      "value": "PREPARED_NOT_QUALIFIED_NOT_SERVICE_READY"
    }
  }
}
