        "format": "uuid"
      },
      "cluster_id": {
        "type": "string",
        "format": "uuid"
      },
      "cluster_name": {
        "type": "string",
        "maxLength": 512
      },
      "api_versions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vmm": {
            "enum": [
              "v4.2",
              "v4.3"
            ]
          },
          "prism": {
            "enum": [
              "v4.2",
              "v4.3"
            ]
          },
          "clustermgmt": {
            "enum": [
              "v4.2",
              "v4.3"
            ]
          },
          "networking": {
            "enum": [
              "v4.2",
              "v4.3"
            ]
          },
          "microseg": {
            "enum": [
              "v4.2",
              "v4.3"
            ]
          }
        },
        "required": [
          "vmm",
          "prism",
          "clustermgmt",
          "networking",
          "microseg"
        ]
