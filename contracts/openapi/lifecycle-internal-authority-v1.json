                "native_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "failure_domain": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "failure_group": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "ledger_revision": {
                  "type": "integer",
                  "minimum": 1
