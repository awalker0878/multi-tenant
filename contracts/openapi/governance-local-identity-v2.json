  },
  "components": {
    "securitySchemes": {
      "ConsoleWorkload": {
        "type": "http",
        "scheme": "bearer",
        "description": "Independent mounted Console workload credential; not a health token."
      },
      "ConsoleSession": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Console-Session",
        "description": "Opaque user authority retained only in the encrypted server-side console session."
      }
    },
    "schemas": {
      "LocalIdentity": {
        "type": "object",
        "required": [
          "subject",
          "password_change_required",
          "permissions"
        ],
        "additionalProperties": false,
        "properties": {
          "subject": {
            "const": "bootstrap-admin"
          },
          "password_change_required": {
            "type": "boolean"
          },
          "permissions": {
            "type": "array",
            "items": {
              "enum": [
                "identity.password.change",
                "identity.logout",
                "identity.setup"
              ]
            },
            "uniqueItems": true,
            "minItems": 2,
            "maxItems": 3
          }
        },
        "oneOf": [
          {
            "properties": {
              "password_change_required": {
                "const": true
              },
              "permissions": {
                "const": [
                  "identity.password.change",
                  "identity.logout"
                ]
              }
            }
          },
          {
            "properties": {
              "password_change_required": {
                "const": false
              },
              "permissions": {
                "const": [
                  "identity.setup",
                  "identity.password.change",
                  "identity.logout"
                ]
              }
            }
          }
        ]
      },
      "Session": {
        "type": "object",
        "required": [
          "session_token",
          "expires_at",
          "identity"
        ],
        "additionalProperties": false,
        "properties": {
          "session_token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Opaque, console-audience credential; server-side custody only. Persisted as SHA-256 in Governance."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "identity": {
            "$ref": "#/components/schemas/Identity"
          }
        }
      },
      "CurrentIdentity": {
        "type": "object",
        "required": [
          "identity"
        ],
        "additionalProperties": false,
        "properties": {
          "identity": {
            "$ref": "#/components/schemas/Identity"
          }
        }
      },
      "Setup": {
        "type": "object",
        "required": [
          "identity",
          "oidc"
        ],
        "additionalProperties": false,
        "properties": {
          "identity": {
            "$ref": "#/components/schemas/Identity"
          },
          "oidc": {
            "type": "object",
            "required": [
              "state"
            ],
            "additionalProperties": false,
            "properties": {
              "state": {
                "enum": [
                  "not_configured",
                  "active"
                ]
              }
            }
          }
        }
      },
      "Logout": {
        "type": "object",
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "signed_out"
          }
        }
      },
      "Error": {
        "title": "Contracted API error v2",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "correlation_id",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,95}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "reason"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      },
      "Login": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 128
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 512
          }
        },
        "additionalProperties": false
      },
      "PasswordChange": {
        "type": "object",
        "required": [
          "current_password",
          "password",
          "password_confirmation"
        ],
        "properties": {
          "current_password": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 512
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "minLength": 15,
            "maxLength": 128
          },
          "password_confirmation": {
            "type": "string",
            "writeOnly": true,
            "minLength": 15,
            "maxLength": 128
          }
        },
        "additionalProperties": false
      },
      "FederatedIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "kind",
          "password_change_required",
          "permissions"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "const": "federated"
          },
          "password_change_required": {
            "const": false
          },
          "permissions": {
            "oneOf": [
              {
                "const": [
                  "identity.logout"
                ]
              },
              {
                "const": [
                  "identity.setup",
                  "tenants.create",
                  "identity.logout"
                ]
              }
            ]
          }
        }
      },
      "Identity": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/LocalIdentity"
          },
          {
            "$ref": "#/components/schemas/FederatedIdentity"
          }
        ]
      }
    }
  }
}
