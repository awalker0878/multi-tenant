{
  "//": "Generated by scripts/build_wsd_compositions.py; restricted native composition.",
  "terraform": {
    "required_version": ">= 1.7.0, < 2.0.0",
    "required_providers": {
      "nutanix": {
        "source": "nutanix/nutanix",
        "version": "= 2.4.2"
      }
    },
    "backend": {
      "http": {}
    }
  },
  "provider": {
    "nutanix": {
      "endpoint": "${var.platform_endpoint}",
      "username": "${var.platform_username}",
      "password": "${var.platform_password}",
      "insecure": false
    }
  },
  "variable": {
    "tenant_key": {
      "type": "string",
      "description": "Stable tenant identifier",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,23}$\", var.tenant_key))}",
          "error_message": "Invalid value for Stable tenant identifier."
        }
      ]
    },
    "allow_restricted_build": {
      "type": "bool",
      "description": "Explicit operator opt-in for an authorized non-production build",
      "nullable": false,
      "default": false
    },
    "test_authorization_ref": {
      "type": "string",
      "description": "Reference to separately issued test-scope authorization",
      "nullable": false
    },
    "wsd_key": {
      "type": "string",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,40}$\", var.wsd_key))}",
          "error_message": "A stable WSD identity is required."
        }
      ]
    },
    "members": {
      "type": "map(object({ipv4_cidr = string, gateway_host_number = optional(number, 1)}))",
      "nullable": false,
      "description": "domains owned by this tenant/WSD; map keys are immutable native identities.",
      "validation": [
        {
          "condition": "${length(var.members) > 0}",
          "error_message": "An empty WSD scope is not an allocation or retirement request."
        }
      ]
    },
    "platform_endpoint": {
      "type": "string",
      "description": "Prism Central endpoint",
      "nullable": false
    },
    "platform_username": {
      "type": "string",
      "description": "Restricted provider account",
      "nullable": false
    },
    "platform_password": {
      "type": "string",
      "description": "Credential injected at execution",
      "nullable": false,
      "sensitive": true
    }
  },
  "module": {
    "owned": {
      "source": "../../../../compositions/nutanix/domains",
      "tenant_key": "${var.tenant_key}",
      "allow_restricted_build": "${var.allow_restricted_build}",
      "test_authorization_ref": "${var.test_authorization_ref}",
      "wsd_key": "${var.wsd_key}",
      "members": "${var.members}"
    }
  },
  "output": {
    "scope": {
      "value": "${module.owned.scope}"
    },
    "members": {
      "value": "${module.owned.members}"
    },
    "delivery_state": {
      "value": "${module.owned.delivery_state}"
    }
  }
}
