                  "maxItems": 100
                }
              },
              "required": [
                "name",
                "owner_id",
                "workload_id",
                "requirements"
              ]
            },
            "minItems": 0,
            "maxItems": 100
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
                },
                "strength": {
                  "enum": [
                    "required",
                    "preferred",
                    "optional"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "integer",
                    "boolean"
                  ],
                  "maxLength": 2048
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "key",
                "strength",
                "value",
                "reason"
              ]
            },
            "minItems": 0,
            "maxItems": 100
          }
        },
        "required": [
          "schema_version",
          "deployment_id",
