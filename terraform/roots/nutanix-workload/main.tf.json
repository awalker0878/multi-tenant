{
  "//": "Operator root: remote HTTP backend is deliberately incomplete; configure accepted HTTPS backend and lock endpoints. Credentials are injected, not checked in.",
  "terraform": {
    "required_version": ">= 1.7.0, < 2.0.0",
    "required_providers": {
      "nutanix": {
        "source": "nutanix/nutanix",
        "version": "= 2.4.2"
      }
    },
    "backend": {
      "http": {}
    }
  },
  "provider": {
    "nutanix": {
      "endpoint": "${var.platform_endpoint}",
      "username": "${var.platform_username}",
      "password": "${var.platform_password}",
      "insecure": false
    }
  },
  "variable": {
    "tenant_key": {
      "type": "string",
      "description": "Stable tenant identifier",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,23}$\", var.tenant_key))}",
          "error_message": "Invalid value for Stable tenant identifier."
        }
      ]
    },
    "domain_key": {
      "type": "string",
      "description": "Stable domain identifier",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[A-Za-z][A-Za-z0-9-]{1,23}$\", var.domain_key))}",
          "error_message": "Invalid value for Stable domain identifier."
        }
      ]
    },
    "allow_restricted_build": {
      "type": "bool",
      "description": "Explicit operator opt-in for an authorized non-production build",
      "nullable": false,
      "default": false
    },
    "test_authorization_ref": {
      "type": "string",
      "description": "Reference to separately issued test-scope authorization",
      "nullable": false
    },
    "workload_key": {
      "type": "string",
      "description": "Owned workload identity",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,40}$\", var.workload_key))}",
          "error_message": "Invalid value for Owned workload identity."
        }
      ]
    },
    "vcpu": {
      "type": "number",
      "description": "Requested guest vCPU",
      "nullable": false,
      "default": 2,
      "validation": [
        {
          "condition": "${var.vcpu >= 1 && floor(var.vcpu) == var.vcpu}",
          "error_message": "Invalid value for Requested guest vCPU."
        }
      ]
    },
    "memory_gib": {
      "type": "number",
      "description": "Requested guest memory in GiB",
      "nullable": false,
      "default": 4,
      "validation": [
        {
          "condition": "${var.memory_gib >= 1 && floor(var.memory_gib) == var.memory_gib}",
          "error_message": "Invalid value for Requested guest memory in GiB."
        }
      ]
    },
    "boot_disk_gib": {
      "type": "number",
      "description": "Requested boot disk GiB; must be at least image/template size",
      "nullable": false,
      "default": 40,
      "validation": [
        {
          "condition": "${var.boot_disk_gib >= 1 && floor(var.boot_disk_gib) == var.boot_disk_gib}",
          "error_message": "Invalid value for Requested boot disk GiB; must be at least image/template size."
        }
      ]
    },
    "data_disk_gib": {
      "type": "number",
      "description": "Owned optional data disk GiB; zero omits",
      "nullable": false,
      "default": 0,
      "validation": [
        {
          "condition": "${var.data_disk_gib >= 0 && floor(var.data_disk_gib) == var.data_disk_gib}",
          "error_message": "Invalid value for Owned optional data disk GiB; zero omits."
        }
      ]
    },
    "accepted_quarantine_ref": {
      "type": "string",
      "description": "Scoped independently reviewed network/policy/placement handoff reference",
      "nullable": false
    },
    "cluster_id": {
      "type": "string",
      "description": "Accepted zone-eligible AHV cluster UUID",
      "nullable": false
    },
    "project_id": {
      "type": "string",
      "description": "Accepted project UUID",
      "nullable": false
    },
    "storage_container_id": {
      "type": "string",
      "description": "Accepted storage-container UUID",
      "nullable": false
    },
    "image_id": {
      "type": "string",
      "description": "Approved boot-image UUID",
      "nullable": false
    },
    "subnet_id": {
      "type": "string",
      "description": "Accepted isolated domain subnet UUID",
      "nullable": false
    },
    "security_category_id": {
      "type": "string",
      "description": "Provider-owned category UUID from domain handoff",
      "nullable": false
    },
    "ipv4_address": {
      "type": "string",
      "description": "Reserved endpoint IPv4 address",
      "nullable": false
    },
    "platform_endpoint": {
      "type": "string",
      "description": "Prism Central endpoint",
      "nullable": false
    },
    "platform_username": {
      "type": "string",
      "description": "Restricted provider account",
      "nullable": false
    },
    "platform_password": {
      "type": "string",
      "description": "Credential injected at execution",
      "nullable": false,
      "sensitive": true
    }
  },
  "module": {
    "owned": {
      "source": "../../modules/nutanix-workload",
      "providers": {
        "nutanix": "nutanix"
      },
      "tenant_key": "${var.tenant_key}",
      "domain_key": "${var.domain_key}",
      "allow_restricted_build": "${var.allow_restricted_build}",
      "test_authorization_ref": "${var.test_authorization_ref}",
      "workload_key": "${var.workload_key}",
      "vcpu": "${var.vcpu}",
      "memory_gib": "${var.memory_gib}",
      "boot_disk_gib": "${var.boot_disk_gib}",
      "data_disk_gib": "${var.data_disk_gib}",
      "accepted_quarantine_ref": "${var.accepted_quarantine_ref}",
      "cluster_id": "${var.cluster_id}",
      "project_id": "${var.project_id}",
      "storage_container_id": "${var.storage_container_id}",
      "image_id": "${var.image_id}",
      "subnet_id": "${var.subnet_id}",
      "security_category_id": "${var.security_category_id}",
      "ipv4_address": "${var.ipv4_address}"
    }
  },
  "output": {
    "handoff": {
      "value": "${module.owned}"
    }
  }
}
