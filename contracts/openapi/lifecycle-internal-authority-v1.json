            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": true
          },
          "field": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "required": [
              "error"
            ]
          },
          {
            "required": [
              "message"
            ]
          }
        ]
      },
