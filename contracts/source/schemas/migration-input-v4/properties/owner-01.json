  "objectives": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "owner_id": {
        "type": "string",
        "format": "uuid"
      },
      "acceptance_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "max_outage_seconds": {
        "type": "integer",
        "minimum": 0,
        "maximum": 31536000
      },
      "max_data_loss_bytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "owner_id",
      "acceptance_sha256",
      "max_outage_seconds",
      "max_data_loss_bytes"
    ]
  },
  "confirmed_by": {
    "type": "string",
    "format": "uuid"
  }
