{
  "MigrationFlowChoices": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "context_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "revision": {
        "type": "integer",
        "minimum": 0
      },
      "expires_at": {
        "type": "integer",
        "minimum": 0
      },
      "choices": {
        "type": "array",
        "maxItems": 512,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_flow_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "protocol": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "port": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "from",
                "to",
                "protocol",
                "port"
              ]
            },
            "required": {
              "type": "boolean"
            },
            "destination_firewall_rule_ids": {
              "type": "array",
              "maxItems": 512,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "destination_route_ids": {
              "type": "array",
              "maxItems": 512,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "status": {
              "enum": [
                "choices_observed",
                "held_unobserved",
                "held_optional"
              ]
            },
            "native_write_authorized": {
              "const": false
            },
            "destination_path_details": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "selector",
                  "route_native_refs",
                  "nat_native_refs"
                ],
                "properties": {
                  "selector": {
                    "type": "string",
                    "pattern": "^path:[a-f0-9]{64}$"
                  },
                  "route_native_refs": {
                    "type": "array",
                    "maxItems": 512,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "nat_native_refs": {
                    "type": "array",
                    "maxItems": 512,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "required": [
            "source_flow_id",
            "source",
            "required",
            "destination_firewall_rule_ids",
            "destination_route_ids",
            "status",
            "native_write_authorized"
          ]
        }
      },
      "selections": {
        "type": "array",
        "maxItems": 512,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_flow_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "rule_native_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "route_native_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "source_flow_id",
            "rule_native_ref",
            "route_native_ref"
          ]
        }
      },
      "holds": {
        "type": "array",
        "maxItems": 512,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "status": {
        "enum": [
          "eligible",
          "held",
          "invalidated"
        ]
      },
      "native_write_authorized": {
        "const": false
      },
      "omissions": {
        "type": "array",
        "maxItems": 512,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_flow_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reason_code": {
              "enum": [
                "retired_dependency",
                "not_required_at_destination",
                "replaced_by_native_service",
                "accepted_service_limitation"
              ]
            }
          },
          "required": [
            "source_flow_id",
            "reason_code"
          ]
        }
      }
    },
    "required": [
      "context_sha256",
      "revision",
      "expires_at",
      "choices",
      "selections",
      "holds",
      "status",
      "native_write_authorized",
      "omissions"
    ]
  },
  "MigrationFlowReceipt": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "revision": {
        "type": "integer",
        "minimum": 1
      },
      "status": {
        "enum": [
          "eligible",
          "held"
        ]
      },
      "holds": {
        "type": "array",
        "maxItems": 512,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "native_write_authorized": {
        "const": false
      }
    },
    "required": [
      "revision",
      "status",
      "holds",
      "native_write_authorized"
    ]
  }
}
