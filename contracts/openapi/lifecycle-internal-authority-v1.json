        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tenant_id",
                  "job_id",
                  "operation_id",
                  "id",
                  "worker_id",
                  "scope"
                ],
                "properties": {
                  "tenant_id": {
                    "type": "string",
