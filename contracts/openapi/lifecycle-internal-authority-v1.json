{
  "openapi": "3.1.0",
  "info": {
    "title": "Lifecycle internal placement and simulation-only authority",
    "version": "1.0.0",
    "description": "Internal bounded authority, E2 simulation evidence only. No E3/E4 or native write permission."
  },
  "security": [
    {
      "WorkloadBearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "WorkloadBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "error": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": true
          },
          "field": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "required": [
              "error"
            ]
          },
          {
            "required": [
              "message"
            ]
          }
        ]
      }
    }
  },
  "paths": {
