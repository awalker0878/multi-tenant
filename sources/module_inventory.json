{
  "nsx-domain": {
    "provider": "nsxt",
    "variables": {
      "tenant_key": {
        "type": "string",
        "description": "Stable tenant identifier",
        "nullable": false,
        "validation": [
          {
            "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,23}$\", var.tenant_key))}",
            "error_message": "Invalid value for Stable tenant identifier."
          }
        ]
      },
      "domain_key": {
        "type": "string",
        "description": "Stable domain identifier",
        "nullable": false,
        "validation": [
          {
            "condition": "${can(regex(\"^[A-Za-z][A-Za-z0-9-]{1,23}$\", var.domain_key))}",
            "error_message": "Invalid value for Stable domain identifier."
          }
        ]
      },
      "allow_restricted_build": {
        "type": "bool",
        "description": "Explicit operator opt-in for an authorized non-production build",
        "nullable": false,
        "default": false
      },
      "test_authorization_ref": {
        "type": "string",
        "description": "Reference to separately issued test-scope authorization",
        "nullable": false
      },
      "ipv4_cidr": {
        "type": "string",
        "description": "Allocated canonical IPv4 domain prefix",
        "nullable": false,
        "validation": [
          {
            "condition": "${can(cidrnetmask(var.ipv4_cidr))}",
            "error_message": "Invalid value for Allocated canonical IPv4 domain prefix."
          }
        ]
      },
      "gateway_host_number": {
        "type": "number",
        "description": "Usable host offset for the native gateway",
        "nullable": false,
        "default": 1,
        "validation": [
          {
            "condition": "${var.gateway_host_number >= 1 && floor(var.gateway_host_number) == var.gateway_host_number}",
            "error_message": "Invalid value for Usable host offset for the native gateway."
          }
        ]
      },
      "transport_zone_path": {
        "type": "string",
        "description": "Accepted NSX Local Manager overlay transport-zone path",
        "nullable": false
      },
      "quarantine_sequence": {
        "type": "number",
        "description": "Provider-reserved Emergency policy sequence",
        "nullable": false,
        "validation": [
          {
            "condition": "${var.quarantine_sequence >= 1 && floor(var.quarantine_sequence) == var.quarantine_sequence}",
            "error_message": "Invalid value for Provider-reserved Emergency policy sequence."
          }
        ]
      }
    },
    "types": [
      "nsxt_policy_tier1_gateway",
      "nsxt_policy_segment",
      "nsxt_policy_group",
      "nsxt_policy_security_policy"
    ],
    "outputs": [
      "tier1_path",
      "segment_path",
      "group_path",
      "quarantine_policy_path",
      "delivery_state"
    ],
    "status": "CANDIDATE_SOURCE_ENGINE_AND_NATIVE_QUALIFICATION_NOT_RUN"
  },
  "nsx-gateway-quarantine": {
    "provider": "nsxt",
    "variables": {
      "tenant_key": {
        "type": "string",
        "description": "Stable tenant identifier",
        "nullable": false,
        "validation": [
          {
            "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,23}$\", var.tenant_key))}",
            "error_message": "Invalid value for Stable tenant identifier."
          }
        ]
      },
      "domain_key": {
        "type": "string",
        "description": "Stable domain identifier",
        "nullable": false,
        "validation": [
          {
            "condition": "${can(regex(\"^[A-Za-z][A-Za-z0-9-]{1,23}$\", var.domain_key))}",
            "error_message": "Invalid value for Stable domain identifier."
          }
        ]
      },
      "allow_restricted_build": {
        "type": "bool",
        "description": "Explicit operator opt-in for an authorized non-production build",
        "nullable": false,
        "default": false
      },
      "test_authorization_ref": {
        "type": "string",
        "description": "Reference to separately issued test-scope authorization",
        "nullable": false
      },
      "engineering_record_ref": {
        "type": "string",
        "description": "External accepted engineering change record; a string is not proof of approval",
        "nullable": false
      },
      "attachment_acceptance_ref": {
        "type": "string",
        "description": "Evidence reference for the existing isolated target attachment and enforcement; not an automatic approval",
        "nullable": false
      },
      "gateway_path": {
        "type": "string",
        "description": "Already accepted isolated gateway with stateful firewall support",
        "nullable": false,
        "validation": [
          {
            "condition": "${can(regex(\"^/infra/tier-[01]s/[^/]+$\", var.gateway_path))}",
            "error_message": "Invalid input: Already accepted isolated gateway with stateful firewall support"
          }
        ]
      },
      "quarantine_sequence": {
        "type": "number",
        "description": "Reserved Emergency policy sequence for this owner",
        "nullable": false,
        "validation": [
          {
            "condition": "${var.quarantine_sequence >= 1 && floor(var.quarantine_sequence) == var.quarantine_sequence}",
            "error_message": "Invalid input: Reserved Emergency policy sequence for this owner"
          }
        ]
      }
    },
    "types": [
      "nsxt_policy_gateway_policy"
    ],
    "outputs": [
      "policy_path",
      "gateway_path"
    ],
    "status": "CANDIDATE_SOURCE_ENGINE_AND_NATIVE_QUALIFICATION_NOT_RUN"
  },
  "nsx-route": {
    "provider": "nsxt",
    "variables": {
      "tenant_key": {
        "type": "string",
        "description": "Stable tenant identifier",
        "nullable": false,
        "validation": [
          {
            "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,23}$\", var.tenant_key))}",
            "error_message": "Invalid value for Stable tenant identifier."
          }
        ]
      },
      "domain_key": {
        "type": "string",
        "description": "Stable domain identifier",
        "nullable": false,
        "validation": [
          {
            "condition": "${can(regex(\"^[A-Za-z][A-Za-z0-9-]{1,23}$\", var.domain_key))}",
            "error_message": "Invalid value for Stable domain identifier."
          }
        ]
      },
      "allow_restricted_build": {
        "type": "bool",
        "description": "Explicit operator opt-in for an authorized non-production build",
        "nullable": false,
        "default": false
      },
      "test_authorization_ref": {
        "type": "string",
        "description": "Reference to separately issued test-scope authorization",
        "nullable": false
      },
      "engineering_record_ref": {
        "type": "string",
        "description": "External accepted engineering change record; a string is not proof of approval",
        "nullable": false
      },
      "attachment_acceptance_ref": {
        "type": "string",
        "description": "Evidence reference for the existing isolated target attachment and enforcement; not an automatic approval",
        "nullable": false
      },
      "route_key": {
        "type": "string",
        "description": "Stable native route identity",
        "nullable": false,
        "validation": [
          {
            "condition": "${can(regex(\"^[A-Za-z][A-Za-z0-9-]{1,31}$\", var.route_key))}",
            "error_message": "Invalid input: Stable native route identity"
          }
        ]
      },
      "destination_cidr": {
        "type": "string",
        "description": "Allocated canonical IPv4 destination; no default route in this increment",
        "nullable": false,
        "validation": [
          {
            "condition": "${can(cidrnetmask(var.destination_cidr)) && try(tonumber(split(\"/\", var.destination_cidr)[1]) > 0, false)}",
            "error_message": "Invalid input: Allocated canonical IPv4 destination; no default route in this increment"
          },
          {
            "condition": "${try(format(\"%s/%s\", cidrhost(var.destination_cidr, 0), split(\"/\", var.destination_cidr)[1]) == var.destination_cidr, false)}",
            "error_message": "Destination must be a canonical IPv4 network."
          }
        ]
      },
      "gateway_path": {
        "type": "string",
        "description": "Existing isolated Tier-0/VRF or Tier-1 gateway policy path",
        "nullable": false,
        "validation": [
          {
            "condition": "${can(regex(\"^/infra/tier-[01]s/[^/]+$\", var.gateway_path))}",
            "error_message": "Invalid input: Existing isolated Tier-0/VRF or Tier-1 gateway policy path"
          }
        ]
      },
      "next_hop_address": {
        "type": "string",
        "description": "Accepted directly reachable IPv4 next hop",
        "nullable": false,
        "validation": [
          {
            "condition": "${can(cidrnetmask(format(\"%s/32\", var.next_hop_address)))}",
            "error_message": "Invalid input: Accepted directly reachable IPv4 next hop"
          }
        ]
      }
    },
    "types": [
      "nsxt_policy_static_route"
    ],
    "outputs": [
      "route_reference",
      "destination_cidr",
      "engineering_record_ref"
    ],
    "status": "CANDIDATE_SOURCE_ENGINE_AND_NATIVE_QUALIFICATION_NOT_RUN"
  },
