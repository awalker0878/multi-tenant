{
  "openapi": "3.1.0",
  "info": {
    "title": "Governance inter-service source and execution checks",
    "version": "1.0.0",
    "description": "Per-request delegation and simulation approval checks only; no reusable native grant."
  },
  "security": [
    {
      "WorkloadBearer": []
    }
  ],
  "paths": {
    "/v1/tenants/{tenant}/planning-input-checks": {
      "post": {
        "operationId": "inspectPlanningSourceAuthority",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          {
            "in": "header",
            "name": "X-Actor-Delegation",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "action",
                  "scope"
                ],
                "properties": {
                  "action": {
                    "enum": [
                      "plan.read",
                      "plan.create"
                    ]
                  },
                  "scope": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "site_id",
                      "environment",
                      "resource_id"
                    ],
                    "properties": {
                      "site_id": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "environment": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      },
                      "resource_id": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current bounded owner result, never a native-write grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanningSourceDecision"
                }
              }
            }
          },
          "401": {
            "description": "HTTP 401: denied, malformed, not found, conflicted, locked, or unavailable as applicable; never authorizes a write",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "HTTP 403: denied, malformed, not found, conflicted, locked, or unavailable as applicable; never authorizes a write",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "HTTP 422: denied, malformed, not found, conflicted, locked, or unavailable as applicable; never authorizes a write",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "HTTP 503: denied, malformed, not found, conflicted, locked, or unavailable as applicable; never authorizes a write",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tenants/{tenant}/execution-approval-checks": {
      "post": {
        "operationId": "inspectExecutionApproval",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "actor_id",
                  "approval_id",
                  "plan_id",
                  "plan_revision",
                  "plan_digest"
                ],
                "properties": {
                  "actor_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "approval_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "plan_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "plan_revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "plan_digest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current bounded owner result, never a native-write grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationConsent"
                }
              }
            }
          },
          "401": {
            "description": "HTTP 401: denied, malformed, not found, conflicted, locked, or unavailable as applicable; never authorizes a write",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "HTTP 403: denied, malformed, not found, conflicted, locked, or unavailable as applicable; never authorizes a write",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "HTTP 404: denied, malformed, not found, conflicted, locked, or unavailable as applicable; never authorizes a write",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Bound-plan digest differs from its canonical binding",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "HTTP 422: denied, malformed, not found, conflicted, locked, or unavailable as applicable; never authorizes a write",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "HTTP 503: denied, malformed, not found, conflicted, locked, or unavailable as applicable; never authorizes a write",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "WorkloadBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "PlanningSourceDecision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allowed",
          "delegation_id",
          "actor_id",
          "delegating_service",
          "audience",
          "tenant_id",
          "action",
          "scope",
          "expires_at",
          "evaluated_at",
          "authority_use",
          "source_owner",
          "source_use"
        ],
        "properties": {
          "allowed": {
            "const": true
          },
          "delegation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "delegating_service": {
            "const": "console"
          },
          "audience": {
            "const": "planning"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "action": {
            "enum": [
              "plan.read",
              "plan.create"
            ]
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "site_id",
              "environment",
              "resource_id"
            ],
            "properties": {
              "site_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "environment": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "resource_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          },
          "expires_at": {
            "type": "string"
          },
          "evaluated_at": {
            "type": "string",
            "format": "date-time"
          },
          "authority_use": {
            "const": "request_bound"
          },
          "source_owner": {
            "enum": [
              "catalogue",
              "inventory",
              "assurance"
            ]
          },
          "source_use": {
            "const": "planning_read_only"
          }
        }
      },
      "SimulationConsent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allowed",
          "tenant_id",
          "actor_id",
          "approval_id",
          "plan_digest",
          "executor_fingerprint",
          "authority_use",
          "evaluated_at",
          "native_write_authorized",
          "approval"
        ],
        "properties": {
          "allowed": {
            "const": true
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "approval_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "plan_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "executor_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "authority_use": {
            "const": "simulation_boundary"
          },
          "evaluated_at": {
            "type": "integer",
            "minimum": 1
          },
          "native_write_authorized": {
            "const": false
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "revoked",
              "plan_digest",
              "plan_id",
              "plan_revision",
              "approver_id",
              "approver_grant_current",
              "expires_at",
              "scope"
            ],
            "properties": {
              "state": {
                "const": "approved"
              },
              "revoked": {
                "const": false
              },
              "plan_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "plan_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "plan_revision": {
                "type": "integer",
                "minimum": 1
              },
              "approver_id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "approver_grant_current": {
                "const": true
              },
              "expires_at": {
                "type": "integer",
                "minimum": 1
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "site_id",
                  "environment",
                  "resource_id"
                ],
                "properties": {
                  "site_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "environment": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "resource_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "error": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": true
          },
          "field": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "required": [
              "error"
            ]
          },
          {
            "required": [
              "message"
            ]
          }
        ]
      }
    }
  }
}
