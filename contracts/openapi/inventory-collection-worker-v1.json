                  "additionalProperties": true,
                  "required": [
                    "job"
                  ],
                  "properties": {
                    "job": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "retry_after": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Inventory rejection 400",
