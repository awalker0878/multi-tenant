APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_KEY=
LOG_LEVEL=info
# No dependency is contacted by the process health endpoints.
# Future persistence needs a private database, role and approved TLS configuration.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD_FILE=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=
