{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.multi-tenant.local/contracts/schemas/common/error-v2.json",
  "title": "Contracted API error v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "correlation_id",
    "retryable"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,95}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  }
}
