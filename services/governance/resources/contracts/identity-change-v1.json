{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/events/identity-change-v1.json",
  "title": "Installation identity committed notification v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_type": {
      "enum": [
        "identity.bootstrap.created",
        "identity.login.denied",
        "identity.login.succeeded",
        "identity.password.denied",
        "identity.password.changed",
        "identity.oidc.settings_saved",
        "identity.oidc.administrator_verified",
        "identity.oidc.activated",
        "identity.federated.login",
        "identity.session.revoked",
        "identity.delegation.issued",
        "identity.delegation.revoked"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "scope": {
      "const": "installation"
    },
    "actor_kind": {
      "enum": [
        "deployment",
        "bootstrap",
        "anonymous",
        "federated"
      ]
    },
    "actor_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "audit_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "authority_use": {
      "const": "notification_only"
    }
  },
  "required": [
    "event_type",
    "schema_version",
    "event_id",
    "scope",
    "actor_kind",
    "actor_id",
    "audit_sha256",
    "occurred_at",
    "authority_use"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "actor_kind": {
            "const": "federated"
          }
        }
      },
      "then": {
        "properties": {
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      },
      "else": {
        "properties": {
          "actor_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "identity.bootstrap.created"
          }
        }
      },
      "then": {
        "properties": {
          "actor_kind": {
            "enum": [
              "deployment"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "identity.login.denied"
          }
        }
      },
      "then": {
        "properties": {
          "actor_kind": {
            "enum": [
              "anonymous"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "identity.login.succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "actor_kind": {
            "enum": [
              "bootstrap"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "identity.password.denied"
          }
        }
      },
      "then": {
        "properties": {
          "actor_kind": {
            "enum": [
              "bootstrap"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "identity.password.changed"
          }
        }
      },
      "then": {
        "properties": {
          "actor_kind": {
            "enum": [
              "bootstrap"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "identity.oidc.settings_saved"
          }
        }
      },
      "then": {
        "properties": {
          "actor_kind": {
            "enum": [
              "bootstrap",
              "federated"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "identity.oidc.administrator_verified"
          }
        }
      },
      "then": {
        "properties": {
          "actor_kind": {
            "enum": [
              "federated"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "identity.oidc.activated"
          }
        }
      },
      "then": {
        "properties": {
          "actor_kind": {
            "enum": [
              "federated"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "identity.federated.login"
          }
        }
      },
      "then": {
        "properties": {
          "actor_kind": {
            "enum": [
              "federated"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "identity.session.revoked"
          }
        }
      },
      "then": {
        "properties": {
          "actor_kind": {
            "enum": [
              "bootstrap",
              "federated"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "identity.delegation.issued"
          }
        }
      },
      "then": {
        "properties": {
          "actor_kind": {
            "enum": [
              "federated"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "identity.delegation.revoked"
          }
        }
      },
      "then": {
        "properties": {
          "actor_kind": {
            "enum": [
              "federated"
            ]
          }
        }
      }
    }
  ]
}
