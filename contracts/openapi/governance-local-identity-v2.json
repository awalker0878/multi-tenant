{
  "openapi": "3.1.0",
  "info": {
    "title": "Governance Console identity",
    "version": "2.0.0",
    "description": "Current bootstrap and federated session identity. Strict server-held identity/session wire; installation-scoped at-most-once credential issuance with no credential replay. No tenant or native authority is minted by this response."
  },
  "security": [
    {
      "ConsoleWorkload": [],
      "ConsoleSession": []
    }
  ],
  "paths": {
    "/identity/local-sessions": {
      "post": {
        "operationId": "loginLocalAdministrator",
        "description": "Authenticate the deployment-created account. A change-required session cannot access setup.",
        "responses": {
          "200": {
            "description": "Success. Responses use Cache-Control: no-store, private.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Denied, invalid input, replay/conflict or dependency unavailable; no authority or credential replay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Denied, invalid input, replay/conflict or dependency unavailable; no authority or credential replay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Denied, invalid input, replay/conflict or dependency unavailable; no authority or credential replay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Denied, invalid input, replay/conflict or dependency unavailable; no authority or credential replay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Denied, invalid input, replay/conflict or dependency unavailable; no authority or credential replay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Denied, invalid input, replay/conflict or dependency unavailable; no authority or credential replay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "security": [
          {
            "ConsoleWorkload": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32,64}$",
              "minLength": 32,
              "maxLength": 64
            },
            "description": "Strong installation/principal/operation command identity; credential issuance is at most once and raw credentials are never replayed."
          }
        ],
        "x-idempotency": {
          "scope": [
            "tenant_id",
            "actor_id",
            "operation_id",
            "request_digest"
          ],
          "ttl_seconds": 604800,
          "conflict_status": 409,
          "description": "tenant_id is null for these installation operations, never a fabricated tenant or a client-selected authority. Additional namespace is the verified installation admission binding and authenticated workload. Actor and session scope are derived by Governance. Credential-issuing retries conflict without secret replay; sign-out remains idempotent."
        }
      }
    },
