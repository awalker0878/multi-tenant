    "/internal/collections/pages": {
      "post": {
        "operationId": "submitCollectionPage",
        "summary": "Inventory bounded worker operation: pages",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "discovery_id",
                  "lease_token",
                  "sequence",
                  "observations",
                  "next_cursor",
                  "terminal",
                  "coverage",
                  "collected_at",
                  "error"
                ],
                "properties": {
                  "discovery_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "lease_token": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "observations": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "next_cursor": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "terminal": {
                    "type": "boolean"
                  },
                  "coverage": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "collected_at": {
                    "type": "integer"
                  },
                  "error": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "configuration": {
                    "type": "object"
                  },
                  "profile": {
                    "type": "object"
                  },
                  "native_read_receipts": {
                    "type": "array"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorized Inventory worker result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "accepted",
                    "discovery_id",
                    "status"
                  ],
                  "properties": {
                    "accepted": {
                      "const": true
                    },
                    "discovery_id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Inventory rejection 400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
