                  "maxLength": 500
                },
                "protocol": {
                  "enum": [
                    "tcp",
                    "udp",
                    "icmp",
                    "none"
                  ]
                },
                "port": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 65535
                },
                "controlled_interface": {
                  "type": "boolean"
