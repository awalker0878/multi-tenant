[Unit]
Description=Commissioned control-application Temporal worker
After=network-online.target
Wants=network-online.target

[Service]
User=hosting-worker
Group=hosting-worker
EnvironmentFile=/etc/hosting/workflow/application-worker.env
ExecStart=/opt/hosting/bin/python -m provisioner.controlplane.workflow.runtime worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillMode=control-group
StateDirectory=hosting-control-application
RuntimeDirectory=hosting-control-application
ReadWritePaths=/var/lib/hosting-control-application /run/hosting-control-application
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
