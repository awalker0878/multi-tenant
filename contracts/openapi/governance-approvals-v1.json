      "get": {
        "operationId": "readApproval",
        "parameters": [
          {
            "in": "header",
            "name": "X-Console-Session",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "description": "Opaque server-held federated user session. Body actor/role values are never authority."
          },
          {
            "in": "path",
            "name": "tenant",
