                  "required": [
                    "id",
                    "version"
                  ]
                },
                "security_domain": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "id",
                    "version"
                  ]
                },
                "compute": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
