{
  "openapi": "3.1.0",
  "info": {
    "title": "Lifecycle native provisioning and retirement jobs",
    "version": "1.0.0",
    "description": "Protected internal interface. Maximum request 4096 bytes. Workload and delegated actor authority are independently current. Plans and responses never grant provider write authority."
  },
  "security": [
    {
      "Workload": []
    }
  ],
  "paths": {
    "/v1/tenants/{tenant}/native-jobs": {
      "post": {
        "operationId": "admitNativeJob",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Actor-Delegation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Current tenant-scoped result; Cache-Control: no-store, private."
          },
          "400": {
            "description": "Denied or held; no native write permission."
          },
          "401": {
            "description": "Denied or held; no native write permission."
          },
          "403": {
            "description": "Denied or held; no native write permission."
          },
          "404": {
            "description": "Denied or held; no native write permission."
          },
          "409": {
            "description": "Denied or held; no native write permission."
          },
          "413": {
            "description": "Denied or held; no native write permission."
          },
          "415": {
            "description": "Denied or held; no native write permission."
          },
          "422": {
            "description": "Denied or held; no native write permission."
          },
          "423": {
            "description": "Denied or held; no native write permission."
          },
          "503": {
            "description": "Denied or held; no native write permission."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanReference"
              }
            }
          }
        }
      }
    },
    "/v1/tenants/{tenant}/native-jobs/{job}": {
      "get": {
        "operationId": "readNativeJob",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Actor-Delegation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current tenant-scoped result; Cache-Control: no-store, private."
          },
          "400": {
            "description": "Denied or held; no native write permission."
          },
          "401": {
            "description": "Denied or held; no native write permission."
          },
          "403": {
            "description": "Denied or held; no native write permission."
          },
          "404": {
            "description": "Denied or held; no native write permission."
          },
          "409": {
            "description": "Denied or held; no native write permission."
          },
          "413": {
            "description": "Denied or held; no native write permission."
          },
          "415": {
            "description": "Denied or held; no native write permission."
          },
          "422": {
            "description": "Denied or held; no native write permission."
          },
          "423": {
            "description": "Denied or held; no native write permission."
          },
          "503": {
            "description": "Denied or held; no native write permission."
          }
        }
      }
    },
    "/v1/tenants/{tenant}/native-jobs/{job}/stop": {
      "post": {
        "operationId": "stopNativeJob",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "job",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-Actor-Delegation",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Current tenant-scoped result; Cache-Control: no-store, private."
          },
          "400": {
            "description": "Denied or held; no native write permission."
          },
          "401": {
            "description": "Denied or held; no native write permission."
          },
          "403": {
            "description": "Denied or held; no native write permission."
          },
          "404": {
            "description": "Denied or held; no native write permission."
          },
          "409": {
            "description": "Denied or held; no native write permission."
          },
          "413": {
            "description": "Denied or held; no native write permission."
          },
          "415": {
            "description": "Denied or held; no native write permission."
          },
          "422": {
            "description": "Denied or held; no native write permission."
          },
          "423": {
            "description": "Denied or held; no native write permission."
          },
          "503": {
            "description": "Denied or held; no native write permission."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Stop"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Workload": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "PlanReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan_id",
          "plan_revision",
          "plan_digest",
          "approval_id"
        ],
        "properties": {
          "plan_id": {
            "type": "string",
            "format": "uuid"
          },
          "plan_revision": {
            "type": "integer",
            "minimum": 1
          },
          "plan_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "approval_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Stop": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_revision"
        ],
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
