{
  "schema_version": 1,
  "scope": "P01 Python bootstrap images; no persistent service or worker execution",
  "components": [
    {
      "id": "planning",
      "context": "services/planning",
      "dockerfile": "Dockerfile",
      "target": "runtime",
      "module": "planning",
      "distribution": "product-planning",
      "version": "0.1.0.dev0",
      "entrypoint": "/opt/venv/bin/planning-health",
      "inputs": [
        "Dockerfile",
        ".dockerignore",
        ".python-version",
        "pyproject.toml",
        "uv.lock",
        "README.md",
        "src"
      ],
      "probe_base": {
        "service": "planning",
        "scope": "process_bootstrap",
        "native_operations_enabled": false
      },
      "readiness_reason": "service_dependencies_not_implemented"
