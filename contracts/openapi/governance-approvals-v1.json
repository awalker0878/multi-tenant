  "components": {
    "securitySchemes": {
      "ConsoleWorkload": {
        "type": "http",
        "scheme": "bearer",
        "description": "Independent mounted Console workload identity; never a health credential."
      }
    },
    "schemas": {
      "BoundPlan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan_id",
          "revision",
          "tenant_id",
          "action",
          "site_id",
          "environment",
          "resource_id",
          "requested_by",
          "executor_ids",
          "valid_until",
          "digest"
        ],
        "properties": {
          "plan_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string",
            "enum": [
              "application.provision",
              "application.migrate",
              "application.recover",
              "application.retire"
            ]
          },
          "site_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "environment": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "resource_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "requested_by": {
            "type": "string",
            "format": "uuid"
          },
          "executor_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "valid_until": {
            "type": "integer"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "ApprovalTransition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "revision",
          "plan_digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "requested",
              "approved",
              "rejected",
              "revoked",
              "expired"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "plan_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expires_at": {
            "type": "string"
          }
        }
      },
      "Approval": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "revision",
          "binding",
          "requester_id",
          "decided_by",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "requested",
              "approved",
              "rejected",
              "revoked",
              "expired"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "binding": {
            "$ref": "#/components/schemas/BoundPlan"
          },
          "requester_id": {
            "type": "string",
            "format": "uuid"
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "type": "string"
          }
        }
      },
      "ApprovalValidation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allowed",
          "approval_id",
          "approval_revision",
          "actor_id",
          "tenant_id",
          "plan_digest",
          "authority_use"
        ],
        "properties": {
          "allowed": {
            "const": true
          },
          "approval_id": {
            "type": "string",
            "format": "uuid"
          },
          "approval_revision": {
            "type": "integer",
            "minimum": 1
          },
          "actor_id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "plan_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "authority_use": {
            "const": "observation_only"
          }
        }
      }
    }
  }
}
