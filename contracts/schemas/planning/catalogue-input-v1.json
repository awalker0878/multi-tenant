                    "rpo_seconds": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 31536000
                    },
                    "rto_seconds": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 31536000
                    },
                    "method": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "strength": {
                      "enum": [
                        "required",
                        "preferred",
                        "optional"
                      ]
                    }
                  },
                  "required": [
                    "rpo_seconds",
                    "rto_seconds",
                    "method",
                    "strength"
                  ]
