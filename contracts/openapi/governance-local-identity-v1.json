{
  "openapi": "3.1.0",
  "info": {
    "title": "Governance local installation identity",
    "version": "1.0.0",
    "description": "P02 bootstrap slice. Workload credentials and browser authority are separate. Provider values are configured as application settings in the external OIDC slice; none are deployment configuration."
  },
  "security": [
    {
      "ConsoleWorkload": [],
      "ConsoleSession": []
    }
  ],
  "paths": {
    "/identity/local-sessions": {
      "post": {
        "operationId": "loginLocalAdministrator",
        "description": "Authenticate the deployment-created account. A change-required session cannot access setup.",
        "responses": {
          "200": {
            "description": "Success. Responses use Cache-Control: no-store, private.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Denied, invalid input, throttled, or unavailable. No credential values are returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Denied, invalid input, throttled, or unavailable. No credential values are returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Denied, invalid input, throttled, or unavailable. No credential values are returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Denied, invalid input, throttled, or unavailable. No credential values are returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Denied, invalid input, throttled, or unavailable. No credential values are returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "security": [
          {
            "ConsoleWorkload": []
          }
        ]
      }
    },
