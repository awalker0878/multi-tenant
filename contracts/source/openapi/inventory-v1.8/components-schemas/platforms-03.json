{
  "VmwareTargetCapabilityProfile": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "profile_type": {
        "const": "TargetCapabilityProfile"
      },
      "installed": {
        "type": "object"
      },
      "observed_at": {
        "type": "integer"
      },
      "observations_sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "inventory_complete": {
        "const": true
      },
      "required_capability_evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 512
        },
        "minItems": 0,
        "maxItems": 32
      },
      "holds": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 512
        },
        "minItems": 0,
        "maxItems": 64
      },
      "native_qualification": {
        "const": "not_established"
      },
      "schema_version": {
        "const": 3
      },
      "platform": {
        "const": "vmware"
      },
      "project_id": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
      },
      "vcenter_uuid": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "api_version": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "disk_formats": {
        "const": [
          "vmdk"
        ]
      },
      "image_import_methods": {
        "const": [
          "vi-json-nfc"
        ]
      },
      "folders": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "folder": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "native_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "folder",
            "name",
            "type",
            "native_sha256"
          ]
        },
        "minItems": 0,
        "maxItems": 100
      },
      "resource_pools": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resource_pool": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "native_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "resource_pool",
            "name",
            "type",
            "native_sha256"
          ]
        },
        "minItems": 0,
        "maxItems": 100
      },
      "hosts": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "native_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "host",
            "name",
            "type",
            "native_sha256"
          ]
        },
        "minItems": 0,
        "maxItems": 100
      },
      "datastores": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "datastore": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "native_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "datastore",
            "name",
            "type",
            "native_sha256"
          ]
        },
        "minItems": 0,
        "maxItems": 100
      },
      "networks": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "network": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "native_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "network",
            "name",
            "type",
            "native_sha256"
          ]
        },
        "minItems": 0,
        "maxItems": 100
      },
      "guest_options_by_host": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "guest_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "minItems": 1,
              "maxItems": 128
            },
            "hardware_versions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "minItems": 1,
              "maxItems": 32
            },
            "native_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "host",
            "guest_ids",
            "hardware_versions",
            "native_sha256"
          ]
        }
      },
      "nsx_policy_observation": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "domain_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "api": {
                "const": "nsx-policy-v1"
              },
              "semantic_qualification": {
                "const": "unresolved"
              },
              "source_vm_attachment": {
                "const": "unverified"
              },
              "native_write_authorized": {
                "const": false
              },
              "policies": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "sequence_number": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "scope_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "native_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "rules": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "action": {
                            "enum": [
                              "ALLOW",
                              "DROP",
                              "REJECT"
                            ]
                          },
                          "direction": {
                            "enum": [
                              "IN",
                              "OUT",
                              "IN_OUT"
                            ]
                          },
                          "disabled": {
                            "type": "boolean"
                          },
                          "native_sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "service_reference_status": {
                            "const": "unresolved"
                          },
                          "group_reference_status": {
                            "const": "unresolved"
                          },
                          "sequence_number": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "source_groups": {
                            "type": "array",
                            "maxItems": 100,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512
                            }
                          },
                          "destination_groups": {
                            "type": "array",
                            "maxItems": 100,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512
                            }
                          },
                          "services": {
                            "type": "array",
                            "maxItems": 100,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512
                            }
                          }
                        },
                        "required": [
                          "id",
                          "action",
                          "direction",
                          "disabled",
                          "native_sha256",
                          "service_reference_status",
                          "group_reference_status",
                          "sequence_number",
                          "source_groups",
                          "destination_groups",
                          "services"
                        ]
                      }
                    },
                    "category": {
                      "anyOf": [
                        {
                          "enum": [
                            "Ethernet",
                            "Emergency",
                            "Infrastructure",
                            "Environment",
                            "Application"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "stateful": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "scope": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    }
                  },
                  "required": [
                    "id",
                    "sequence_number",
                    "scope_sha256",
                    "native_sha256",
                    "rules",
                    "category",
                    "stateful",
                    "scope"
                  ]
                }
              },
              "groups": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "native_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "definition_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "resolution": {
                      "const": "unverified"
                    }
                  },
                  "required": [
                    "id",
                    "native_sha256",
                    "definition_sha256",
                    "resolution"
                  ]
                }
              },
              "services": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "native_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "definition_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "resolution": {
                      "const": "unverified"
                    }
                  },
                  "required": [
                    "id",
                    "native_sha256",
                    "definition_sha256",
                    "resolution"
                  ]
                }
              },
              "holds": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "required": [
              "domain_id",
              "api",
              "policies",
              "semantic_qualification",
              "source_vm_attachment",
              "native_write_authorized",
              "groups",
              "services",
              "holds"
            ]
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "profile_type",
      "installed",
      "observed_at",
      "observations_sha256",
      "inventory_complete",
      "required_capability_evidence",
      "holds",
      "native_qualification",
      "schema_version",
      "platform",
      "project_id",
      "vcenter_uuid",
      "api_version",
      "disk_formats",
      "image_import_methods",
      "folders",
      "resource_pools",
      "hosts",
      "datastores",
      "networks",
      "guest_options_by_host",
      "nsx_policy_observation"
    ]
  },
  "OpenstackSecurityDestinationSelection": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "platform": {
        "const": "openstack"
      },
      "project_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "security_mappings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "destination_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "required": [
            "source_id",
            "destination_id"
          ]
        },
        "minItems": 0,
        "maxItems": 64
      },
      "flow_mappings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_group_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "source_rule_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "destination_rule_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "required": [
            "source_group_id",
            "source_rule_id",
            "destination_rule_id"
          ]
        },
        "minItems": 0,
        "maxItems": 1024
      }
    },
    "required": [
      "platform",
      "project_id",
      "security_mappings"
    ]
  },
  "VmwareDestinationSelection": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "platform": {
        "const": "vmware"
      },
      "project_id": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
      },
      "vcenter_uuid": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "folder_id": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
      },
      "resource_pool_id": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
      },
      "host_id": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
      },
      "datastore_id": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
      },
      "guest_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 85
      },
      "hardware_version": {
        "type": "string",
        "pattern": "^vmx-[0-9]{2}$"
      },
      "firmware": {
        "enum": [
          "bios",
          "efi",
          ""
        ]
      },
      "disks": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_key": {
              "type": "integer",
              "minimum": 0
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            }
          },
          "required": [
            "source_key",
            "index"
          ]
        },
        "minItems": 1,
        "maxItems": 32
      },
      "nics": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_key": {
              "type": "integer",
              "minimum": 0
            },
            "quarantine_network_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "production_network_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            }
          },
          "required": [
            "source_key",
            "quarantine_network_id",
            "production_network_id"
          ]
        },
        "minItems": 0,
        "maxItems": 32
      }
    },
    "required": [
      "platform",
      "project_id",
      "vcenter_uuid",
      "folder_id",
      "resource_pool_id",
      "host_id",
      "datastore_id",
      "guest_id",
      "hardware_version",
      "firmware",
      "disks",
      "nics"
    ]
  }
}
