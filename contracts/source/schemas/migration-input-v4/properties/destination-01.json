{
  "target": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "profile_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "native_identity_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "tuple_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "observed_at": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "expires_at": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "profile_sha256",
      "native_identity_sha256",
      "tuple_sha256",
      "observed_at",
      "expires_at"
    ]
  },
  "datasets": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "disk_keys": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxItems": 32,
          "minItems": 1,
          "uniqueItems": true
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "maxItems": 32,
          "minItems": 1
        },
        "consistency_group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "validation_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "required": [
        "id",
        "name",
        "disk_keys",
        "mounts",
        "consistency_group",
        "validation_reference"
      ]
    },
    "maxItems": 256
  },
  "disks": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capacity_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "controller_key": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "unit_number": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "backing_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 240
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mode": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 240
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "identity_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "encrypted": {
                "type": "boolean"
              },
              "datastore": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "type": "string",
                        "maxLength": 240
                      },
                      "value": {
                        "type": "string",
                        "maxLength": 240
                      }
                    },
                    "required": [
                      "type",
                      "value"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sharing": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 240
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "type",
              "mode",
              "identity_sha256",
              "encrypted",
              "datastore",
              "sharing"
            ]
          },
          "maxItems": 32
        },
        "native_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "key",
        "capacity_bytes",
        "controller_key",
        "unit_number",
        "backing_chain",
        "native_sha256"
      ]
    },
    "maxItems": 32
  }
}
