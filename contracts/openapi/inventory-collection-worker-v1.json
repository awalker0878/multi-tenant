{
  "openapi": "3.1.0",
  "info": {
    "title": "Inventory authenticated collection worker",
    "version": "1.0.0",
    "description": "Collection leases, bounded reads and signed receipt custody, never native-write authority."
  },
  "security": [
    {
      "WorkloadBearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "WorkloadBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "error": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": true
          },
          "field": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "required": [
              "error"
            ]
          },
          {
            "required": [
              "message"
            ]
          }
        ]
      }
    }
  },
