            "securedGroups": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "minItems": 0,
                  "maxItems": 100
                },
                {
                  "type": "null"
                }
              ]
