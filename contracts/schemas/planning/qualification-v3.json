{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "const": 2,
      "type": "integer"
    },
    "status": {
      "enum": [
        "qualified",
        "unknown",
        "unsupported"
      ]
    },
    "evidence_level": {
      "enum": [
        null,
        "E0",
        "E1",
        "E2",
        "E3",
        "E4"
      ]
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0
    },
    "revoked": {
      "type": "boolean"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "site_id": {
          "type": "string",
          "format": "uuid"
        },
        "endpoint_id": {
          "type": "string",
          "format": "uuid"
        },
        "native_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "installed_tuple": {
          "type": "object",
          "minProperties": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "application.provision",
            "application.migrate",
            "application.recover",
            "application.retire"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "profile_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "compiler": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "adapter": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "automation": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "contracts": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "compiler",
            "adapter",
            "automation",
            "contracts"
          ]
        }
      },
      "required": [
        "tenant_id",
        "site_id",
        "endpoint_id",
        "native_scope",
        "installed_tuple",
        "action",
        "method",
        "profile_digest",
        "artifacts"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 1000
    },
    "dimensions": {
      "type": "array",
      "items": {
        "enum": [
          "installed_identity",
          "compute_placement",
          "storage_datasets",
          "network_vpc",
          "security_edge",
          "guest_image",
          "lifecycle_adoption",
          "mobility",
          "shared_services",
          "resilience_operations",
          "assurance_sovereignty"
        ]
      },
      "maxItems": 1000
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "observed",
              "supported",
              "unsupported",
              "unknown"
            ]
          },
          "expires_at": {
            "type": "integer",
            "minimum": 0
          },
          "values": {
            "type": "array",
            "items": {},
            "maxItems": 1000
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1000
          }
        },
        "required": [
          "status",
          "expires_at",
          "values",
          "dependencies"
        ]
      },
      "maxProperties": 1000
    },
    "verification": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "valid": {
              "const": true
            },
            "definition_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "decision_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "runtime_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "record_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "resolved_at": {
              "type": "integer",
              "minimum": 0
            },
            "expires_at": {
              "type": "integer",
              "minimum": 0
            },
            "acceptance_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "authority_epoch": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "valid",
            "definition_sha256",
            "decision_sha256",
            "runtime_sha256",
            "record_sha256",
            "resolved_at",
            "expires_at"
          ]
        }
      ]
    },
    "method_modes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method:VM_COLD_EXPORT:rehearsal",
        "method:VM_COLD_EXPORT:cutover",
        "method:VM_COLD_EXPORT:rollback",
        "method:VM_COLD_EXPORT:forward_recovery",
        "method:VM_COLD_EXPORT:reverse_recovery",
        "method:VM_COLD_EXPORT:cleanup",
        "method:APPLICATION_REBUILD_RESTORE:rehearsal",
        "method:APPLICATION_REBUILD_RESTORE:cutover",
        "method:APPLICATION_REBUILD_RESTORE:rollback",
        "method:APPLICATION_REBUILD_RESTORE:forward_recovery",
        "method:APPLICATION_REBUILD_RESTORE:reverse_recovery",
        "method:APPLICATION_REBUILD_RESTORE:cleanup",
        "method:VM_SNAPSHOT_BASELINE_APP_DELTA:rehearsal",
        "method:VM_SNAPSHOT_BASELINE_APP_DELTA:cutover",
        "method:VM_SNAPSHOT_BASELINE_APP_DELTA:rollback",
        "method:VM_SNAPSHOT_BASELINE_APP_DELTA:forward_recovery",
        "method:VM_SNAPSHOT_BASELINE_APP_DELTA:reverse_recovery",
        "method:VM_SNAPSHOT_BASELINE_APP_DELTA:cleanup",
        "method:VM_SNAPSHOT_BASELINE_FILE_DELTA:rehearsal",
        "method:VM_SNAPSHOT_BASELINE_FILE_DELTA:cutover",
        "method:VM_SNAPSHOT_BASELINE_FILE_DELTA:rollback",
        "method:VM_SNAPSHOT_BASELINE_FILE_DELTA:forward_recovery",
        "method:VM_SNAPSHOT_BASELINE_FILE_DELTA:reverse_recovery",
        "method:VM_SNAPSHOT_BASELINE_FILE_DELTA:cleanup",
        "method:EXTERNAL_BLOCK_REPLICATION:rehearsal",
        "method:EXTERNAL_BLOCK_REPLICATION:cutover",
        "method:EXTERNAL_BLOCK_REPLICATION:rollback",
        "method:EXTERNAL_BLOCK_REPLICATION:forward_recovery",
        "method:EXTERNAL_BLOCK_REPLICATION:reverse_recovery",
        "method:EXTERNAL_BLOCK_REPLICATION:cleanup"
      ],
      "properties": {
        "method:VM_COLD_EXPORT:rehearsal": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_COLD_EXPORT:cutover": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_COLD_EXPORT:rollback": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_COLD_EXPORT:forward_recovery": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_COLD_EXPORT:reverse_recovery": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_COLD_EXPORT:cleanup": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:APPLICATION_REBUILD_RESTORE:rehearsal": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:APPLICATION_REBUILD_RESTORE:cutover": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:APPLICATION_REBUILD_RESTORE:rollback": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:APPLICATION_REBUILD_RESTORE:forward_recovery": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:APPLICATION_REBUILD_RESTORE:reverse_recovery": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:APPLICATION_REBUILD_RESTORE:cleanup": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_SNAPSHOT_BASELINE_APP_DELTA:rehearsal": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_SNAPSHOT_BASELINE_APP_DELTA:cutover": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_SNAPSHOT_BASELINE_APP_DELTA:rollback": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_SNAPSHOT_BASELINE_APP_DELTA:forward_recovery": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_SNAPSHOT_BASELINE_APP_DELTA:reverse_recovery": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_SNAPSHOT_BASELINE_APP_DELTA:cleanup": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_SNAPSHOT_BASELINE_FILE_DELTA:rehearsal": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_SNAPSHOT_BASELINE_FILE_DELTA:cutover": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_SNAPSHOT_BASELINE_FILE_DELTA:rollback": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_SNAPSHOT_BASELINE_FILE_DELTA:forward_recovery": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_SNAPSHOT_BASELINE_FILE_DELTA:reverse_recovery": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:VM_SNAPSHOT_BASELINE_FILE_DELTA:cleanup": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:EXTERNAL_BLOCK_REPLICATION:rehearsal": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:EXTERNAL_BLOCK_REPLICATION:cutover": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:EXTERNAL_BLOCK_REPLICATION:rollback": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:EXTERNAL_BLOCK_REPLICATION:forward_recovery": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:EXTERNAL_BLOCK_REPLICATION:reverse_recovery": {
          "enum": [
            "passed",
            "unsupported"
          ]
        },
        "method:EXTERNAL_BLOCK_REPLICATION:cleanup": {
          "enum": [
            "passed",
            "unsupported"
          ]
        }
      }
    }
  },
  "required": [
    "id",
    "version",
    "status",
    "evidence_level",
    "expires_at",
    "revoked",
    "scope",
    "evidence_refs",
    "dimensions",
    "capabilities",
    "verification"
  ],
  "$id": "https://schemas.multi-tenant.local/contracts/schemas/planning/qualification-v3.json",
  "title": "Resolved current Assurance qualification v3",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "qualified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "revoked": {
            "const": false
          },
          "verification": {
            "type": "object",
            "properties": {
              "valid": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "qualified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "method_modes"
        ]
      }
    }
  ]
}
