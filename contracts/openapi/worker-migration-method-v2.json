        "required": [
          "schema_version",
          "binding",
          "intent"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          },
          "binding": {
            "$ref": "#/components/schemas/NativeBinding"
          },
          "intent": {
            "$ref": "#/components/schemas/MethodPlan"
          }
        }
      },
      "MethodEffectReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_sha256",
          "intent_sha256",
          "receipt_sha256",
          "submitted",
          "retry_authorized",
          "method_contract_sha256",
          "task_id"
        ],
        "properties": {
          "binding_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "intent_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "submitted": {
            "const": true
          },
          "retry_authorized": {
            "const": false
          },
          "method_contract_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:/-]{1,200}$"
          }
        }
      },
      "MethodObservationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "binding",
          "objects",
          "intent"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          },
          "binding": {
            "$ref": "#/components/schemas/NativeBinding"
          },
          "objects": {
            "type": "object"
          },
          "intent": {
            "$ref": "#/components/schemas/MethodPlan"
          }
        }
      },
      "MethodObservation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "binding_sha256",
          "intent_sha256",
          "observer_id",
          "independent",
          "outcome",
          "observed_at",
          "evidence_sha256",
          "measurement"
        ],
        "properties": {
          "binding_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "intent_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observer_id": {
            "type": "string",
            "format": "uuid"
          },
          "independent": {
            "const": true
          },
          "outcome": {
            "enum": [
              "observed_present",
              "held"
            ]
          },
          "observed_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "measurement": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Measurement"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "observed_present"
                }
              }
            },
            "then": {
              "properties": {
                "measurement": {
                  "$ref": "#/components/schemas/Measurement"
                }
              }
            },
            "else": {
              "properties": {
                "measurement": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "Measurement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method_contract_sha256",
          "datasets",
          "source_writer_fenced",
          "target_writer_fenced",
          "elapsed_seconds",
          "consistency_boundary_sha256",
          "recovery_sha256"
        ],
        "properties": {
          "method_contract_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "datasets": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 256,
            "propertyNames": {
              "type": "string",
              "format": "uuid"
            },
            "additionalProperties": {
              "$ref": "#/components/schemas/DatasetMeasurement"
            }
          },
          "source_writer_fenced": {
            "type": "boolean"
          },
          "target_writer_fenced": {
            "const": true
          },
          "elapsed_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "consistency_boundary_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "recovery_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "DatasetMeasurement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_sha256",
          "source_boundary_sha256",
          "target_boundary_sha256",
          "evidence_sha256",
          "observed_at",
          "lag_seconds",
          "data_loss_bytes",
          "integrity_verified",
          "metadata_verified"
        ],
        "properties": {
          "dataset_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_boundary_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "target_boundary_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observed_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "lag_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "data_loss_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "integrity_verified": {
            "const": true
          },
          "metadata_verified": {
            "const": true
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,160}$"
          }
        }
      }
    }
  }
}
