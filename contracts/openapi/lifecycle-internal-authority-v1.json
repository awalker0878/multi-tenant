                "vector": {
                  "type": "object",
                  "required": [
                    "vcpus",
                    "memory_mib",
                    "storage_gib",
                    "addresses"
                  ],
                  "properties": {
                    "vcpus": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "memory_mib": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "storage_gib": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "addresses": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "patternProperties": {
                    "^(storage_gib:[^:]{1,64}|addresses:[^:]{1,64}:(ipv4|ipv6))$": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "state": {
            "enum": [
