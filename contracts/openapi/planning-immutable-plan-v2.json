{
  "openapi": "3.1.0",
  "info": {
    "title": "Immutable planning binding consumed by Governance",
    "version": "2.0.0",
    "description": "Tenant-scoped immutable planning binding consumed only by Governance. Old unscoped endpoint is removed, not aliased. All errors use the current closed Error v2 envelope."
  },
  "security": [
    {
      "GovernanceWorkload": []
    }
  ],
  "paths": {
    "/v1/tenants/{tenant}/plans/{plan}/revisions/{revision}": {
      "get": {
        "operationId": "getImmutablePlan",
        "parameters": [
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "plan",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "path",
            "name": "revision",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; Cache-Control: no-store, private",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BoundPlan"
                }
              }
            }
          },
          "401": {
            "description": "Invalid workload or user session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Current scope/action denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource or no membership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Revision, retry, binding or transition conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "423": {
            "description": "Current qualification or plan custody held",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Required authority unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "GovernanceWorkload": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "BoundPlan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan_id",
          "revision",
          "tenant_id",
          "action",
          "site_id",
          "environment",
          "resource_id",
          "requested_by",
          "executor_ids",
          "valid_until",
          "digest",
          "content_digest",
          "canonicalization",
          "lane"
        ],
        "properties": {
          "plan_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "action": {
            "type": "string",
            "enum": [
              "application.provision",
              "application.migrate",
              "application.recover",
              "application.retire"
            ]
          },
          "site_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "environment": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "resource_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,128}$"
          },
          "requested_by": {
            "type": "string",
            "format": "uuid"
          },
          "executor_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "valid_until": {
            "type": "integer"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "canonicalization": {
            "const": "p05-json-v1"
          },
          "lane": {
            "enum": [
              "operational",
              "isolated_campaign"
            ]
          }
        }
      },
      "Error": {
        "title": "Contracted API error v2",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "correlation_id",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,95}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "reason"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    }
  }
}
