              ],
              "maxLength": 512
            },
            "isMarkedForRemoval": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "isInternal": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "maxCapacityBytes": {
              "type": [
                "integer",
