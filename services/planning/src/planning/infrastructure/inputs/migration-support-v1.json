{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "tranche_sha256",
    "release_sha256",
    "records",
    "native_write_authorized",
    "flow_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "site_id",
        "resource_id",
        "environment"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "site_id": {
          "type": "string",
          "format": "uuid"
        },
        "resource_id": {
          "type": "string",
          "format": "uuid"
        },
        "environment": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "tranche_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "release_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_sha256",
          "tranche_sha256",
          "release_sha256",
          "level",
          "decision",
          "revoked",
          "expires_at",
          "evidence_sha256"
        ],
        "properties": {
          "route_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "tranche_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "release_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "level": {
            "enum": [
              "E0",
              "E1",
              "E2",
              "E3",
              "E4"
            ]
          },
          "decision": {
            "enum": [
              "accepted",
              "rejected",
              "not_reviewed"
            ]
          },
          "revoked": {
            "type": "boolean"
          },
          "expires_at": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "native_write_authorized": {
      "const": false
    },
    "api_evidence": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {
        "pattern": "^[a-f0-9]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_sha256",
          "environments",
          "observations",
          "omissions"
        ],
        "properties": {
          "route_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "environments": {
            "type": "object"
          },
          "observations": {
            "type": "array",
            "maxItems": 512
          },
          "omissions": {
            "type": "array",
            "maxItems": 64
          }
        }
      }
    },
    "flow_evidence": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "assessment_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_revision_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_intent_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "context_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "selections_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "destination_generation_id": {
              "type": "string",
              "format": "uuid"
            },
            "platform": {
              "enum": [
                "openstack",
                "vmware",
                "ahv"
              ]
            },
            "observed_at": {
              "type": "integer",
              "minimum": 0
            },
            "expires_at": {
              "type": "integer",
              "minimum": 0
            },
            "level": {
              "const": "E4"
            },
            "decision": {
              "const": "accepted"
            },
            "checks": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "native_controls": {
                  "const": "passed"
                },
                "source_completeness": {
                  "const": "passed"
                },
                "allowed_traffic": {
                  "const": "passed"
                },
                "denied_traffic": {
                  "const": "passed"
                },
                "return_path": {
                  "const": "passed"
                },
                "tenant_isolation": {
                  "const": "passed"
                },
                "application_validation": {
                  "const": "passed"
                }
              },
              "required": [
                "native_controls",
                "source_completeness",
                "allowed_traffic",
                "denied_traffic",
                "return_path",
                "tenant_isolation",
                "application_validation"
              ]
            },
            "native_write_authorized": {
              "const": false
            },
            "native_controls_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "omissions_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "omissions_approved": {
              "type": "boolean"
            },
            "omission_approver_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "security_cases": {
              "type": "array",
              "maxItems": 512,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_flow_id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "flow": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "from",
                      "to",
                      "protocol",
                      "port"
                    ],
                    "properties": {
                      "from": {
                        "type": "string",
                        "minLength": 1
                      },
                      "to": {
                        "type": "string",
                        "minLength": 1
                      },
                      "protocol": {
                        "enum": [
                          "tcp",
                          "udp",
                          "icmp"
                        ]
                      },
                      "port": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 65535
                      }
                    }
                  },
                  "document": {
                    "type": "object"
                  }
                },
                "required": [
                  "source_flow_id",
                  "flow",
                  "document"
                ]
              }
            }
          },
          "required": [
            "schema_version",
            "assessment_id",
            "source_revision_id",
            "source_intent_sha256",
            "context_sha256",
            "selections_sha256",
            "destination_generation_id",
            "platform",
            "observed_at",
            "expires_at",
            "level",
            "decision",
            "checks",
            "native_write_authorized",
            "native_controls_sha256",
            "omissions_sha256",
            "omissions_approved",
            "omission_approver_id",
            "security_cases"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
