          "required": [
            "extId",
            "native_sha256",
            "name",
            "state",
            "type",
            "projectExtId",
            "isSharedWithAllProjects",
            "scope",
            "scopeReferences",
            "vpcReferences",
            "securedGroups"
          ]
        },
        "minItems": 0,
        "maxItems": 1000
