{
  "//": "Operator root: remote HTTP backend is deliberately incomplete; configure accepted HTTPS backend and lock endpoints. Credentials are injected, not checked in.",
  "terraform": {
    "required_version": ">= 1.7.0, < 2.0.0",
    "required_providers": {
      "nsxt": {
        "source": "vmware/nsxt",
        "version": "= 3.10.0"
      }
    },
    "backend": {
      "http": {}
    }
  },
  "provider": {
    "nsxt": {
      "host": "${var.platform_endpoint}",
      "username": "${var.platform_username}",
      "password": "${var.platform_password}",
      "allow_unverified_ssl": false
    }
  },
  "variable": {
    "tenant_key": {
      "type": "string",
      "description": "Stable tenant identifier",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,23}$\", var.tenant_key))}",
          "error_message": "Invalid value for Stable tenant identifier."
        }
      ]
    },
    "domain_key": {
      "type": "string",
      "description": "Stable domain identifier",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[A-Za-z][A-Za-z0-9-]{1,23}$\", var.domain_key))}",
          "error_message": "Invalid value for Stable domain identifier."
        }
      ]
    },
    "allow_restricted_build": {
      "type": "bool",
      "description": "Explicit operator opt-in for an authorized non-production build",
      "nullable": false,
      "default": false
    },
    "test_authorization_ref": {
      "type": "string",
      "description": "Reference to separately issued test-scope authorization",
      "nullable": false
    },
    "ipv4_cidr": {
      "type": "string",
      "description": "Allocated canonical IPv4 domain prefix",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(cidrnetmask(var.ipv4_cidr))}",
          "error_message": "Invalid value for Allocated canonical IPv4 domain prefix."
        }
      ]
    },
    "gateway_host_number": {
      "type": "number",
      "description": "Usable host offset for the native gateway",
      "nullable": false,
      "default": 1,
      "validation": [
        {
          "condition": "${var.gateway_host_number >= 1 && floor(var.gateway_host_number) == var.gateway_host_number}",
          "error_message": "Invalid value for Usable host offset for the native gateway."
        }
      ]
    },
    "transport_zone_path": {
      "type": "string",
      "description": "Accepted NSX Local Manager overlay transport-zone path",
      "nullable": false
    },
    "quarantine_sequence": {
      "type": "number",
      "description": "Provider-reserved Emergency policy sequence",
      "nullable": false,
      "validation": [
        {
          "condition": "${var.quarantine_sequence >= 1 && floor(var.quarantine_sequence) == var.quarantine_sequence}",
          "error_message": "Invalid value for Provider-reserved Emergency policy sequence."
        }
      ]
    },
    "platform_endpoint": {
      "type": "string",
      "description": "NSX Local Manager endpoint",
      "nullable": false
    },
    "platform_username": {
      "type": "string",
      "description": "Restricted provider account",
      "nullable": false
    },
    "platform_password": {
      "type": "string",
      "description": "Credential injected at execution",
      "nullable": false,
      "sensitive": true
    }
  },
  "module": {
    "owned": {
      "source": "../../modules/nsx-domain",
      "providers": {
        "nsxt": "nsxt"
      },
      "tenant_key": "${var.tenant_key}",
      "domain_key": "${var.domain_key}",
      "allow_restricted_build": "${var.allow_restricted_build}",
      "test_authorization_ref": "${var.test_authorization_ref}",
      "ipv4_cidr": "${var.ipv4_cidr}",
      "gateway_host_number": "${var.gateway_host_number}",
      "transport_zone_path": "${var.transport_zone_path}",
      "quarantine_sequence": "${var.quarantine_sequence}"
    }
  },
  "output": {
    "handoff": {
      "value": "${module.owned}"
    }
  }
}
