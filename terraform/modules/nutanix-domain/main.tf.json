{
  "//": "Restricted domain preparation and exact Flow service bootstrap. Native policy precedence and enforcement require qualification.",
  "terraform": {
    "required_version": ">= 1.7.0, < 2.0.0",
    "required_providers": {
      "nutanix": {
        "source": "nutanix/nutanix",
        "version": "= 2.4.2"
      }
    }
  },
  "variable": {
    "tenant_key": {
      "type": "string",
      "description": "Stable tenant identifier",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,23}$\", var.tenant_key))}",
          "error_message": "Invalid value for Stable tenant identifier."
        }
      ]
    },
    "domain_key": {
      "type": "string",
      "description": "Stable domain identifier",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[A-Za-z][A-Za-z0-9-]{1,23}$\", var.domain_key))}",
          "error_message": "Invalid value for Stable domain identifier."
        }
      ]
    },
    "allow_restricted_build": {
      "type": "bool",
      "description": "Explicit operator opt-in for an authorized non-production build",
      "nullable": false,
      "default": false
    },
    "test_authorization_ref": {
      "type": "string",
      "description": "Reference to separately issued test-scope authorization",
      "nullable": false
    },
    "ipv4_cidr": {
      "type": "string",
      "description": "Allocated canonical IPv4 domain prefix",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(cidrnetmask(var.ipv4_cidr))}",
          "error_message": "Invalid value for Allocated canonical IPv4 domain prefix."
        }
      ]
    },
    "gateway_host_number": {
      "type": "number",
      "description": "Usable host offset for the native gateway",
      "nullable": false,
      "default": 1,
      "validation": [
        {
          "condition": "${var.gateway_host_number >= 1 && floor(var.gateway_host_number) == var.gateway_host_number}",
          "error_message": "Invalid value for Usable host offset for the native gateway."
        }
      ]
    },
    "lifecycle_stage": {
      "type": "string",
      "nullable": false,
      "default": "prepared",
      "description": "Owned lifecycle target: prepared (held down) or bootstrap (explicit restricted service paths).",
      "validation": [
        {
          "condition": "${contains([\"prepared\", \"bootstrap\"], var.lifecycle_stage)}",
          "error_message": "Only prepared or restricted bootstrap is implemented."
        }
      ]
    },
    "bootstrap_acceptance_ref": {
      "type": "string",
      "nullable": false,
      "default": "",
      "description": "Independent current mandatory-policy, edge, image and placement acceptance for restricted bootstrap."
    },
    "bootstrap_rules": {
      "type": "map(object({direction = string, protocol = string, port = number, remote_ipv4 = string}))",
      "nullable": false,
      "default": {},
      "description": "Stable owned rule keys; exact endpoint and TCP/UDP port only. Keep existing rules during withdrawal; disabled interfaces contain exposure.",
      "validation": [
        {
          "condition": "${length(var.bootstrap_rules) <= 32 && alltrue([for key, r in var.bootstrap_rules : can(regex(\"^[a-z][a-z0-9-]{1,40}$\", key)) && contains([\"ingress\", \"egress\"], r.direction) && contains([\"tcp\", \"udp\"], r.protocol) && r.port >= 1 && r.port <= 65535 && floor(r.port) == r.port && can(cidrnetmask(\"${r.remote_ipv4}/32\"))])}",
          "error_message": "At most 32 named exact IPv4 TCP/UDP service rules are supported."
        }
      ]
    }
  },
  "resource": {
    "nutanix_category_v2": {
      "domain": {
        "key": "hosting-domain",
        "value": "${var.tenant_key}-${var.domain_key}",
        "type": "USER",
        "description": "Provider-owned security membership for an isolated test domain.",
        "lifecycle": {
          "prevent_destroy": true,
          "precondition": [
            {
              "condition": "${var.allow_restricted_build && length(trimspace(var.test_authorization_ref)) > 0}",
              "error_message": "Restricted build is not opted in or the external test-authorization reference is missing. No production activation is implemented."
            }
          ]
        }
      }
    },
    "nutanix_vpc_v2": {
      "domain": {
        "name": "${var.tenant_key}-${var.domain_key}",
        "vpc_type": "REGULAR",
        "description": "Restricted domain with no external-subnet attachment.",
        "lifecycle": {
          "prevent_destroy": true,
          "precondition": [
            {
              "condition": "${var.allow_restricted_build && length(trimspace(var.test_authorization_ref)) > 0}",
              "error_message": "Restricted build is not opted in or the external test-authorization reference is missing. No production activation is implemented."
            }
          ]
        }
      }
    },
    "nutanix_subnet_v2": {
      "domain": {
        "name": "${var.tenant_key}-${var.domain_key}-network",
        "subnet_type": "OVERLAY",
        "is_external": false,
        "vpc_reference": "${nutanix_vpc_v2.domain.ext_id}",
        "ip_config": [
          {
            "ipv4": [
              {
                "ip_subnet": [
                  {
                    "ip": [
                      {
                        "value": "${cidrhost(var.ipv4_cidr, 0)}"
                      }
                    ],
                    "prefix_length": "${tonumber(split(\"/\", var.ipv4_cidr)[1])}"
                  }
                ],
                "default_gateway_ip": [
                  {
                    "value": "${cidrhost(var.ipv4_cidr, var.gateway_host_number)}"
                  }
                ]
              }
            ]
          }
        ],
        "lifecycle": {
          "prevent_destroy": true,
          "precondition": [
            {
              "condition": "${var.allow_restricted_build && length(trimspace(var.test_authorization_ref)) > 0}",
              "error_message": "Restricted build is not opted in or the external test-authorization reference is missing. No production activation is implemented."
            }
          ]
        }
      }
    },
    "nutanix_network_security_policy_v2": {
      "quarantine": {
        "name": "${var.tenant_key}-${var.domain_key}-quarantine",
        "type": "APPLICATION",
        "state": "ENFORCE",
        "scope": "VPC_LIST",
        "vpc_reference": [
          "${nutanix_vpc_v2.domain.ext_id}"
        ],
        "is_hitlog_enabled": true,
        "is_ipv6_traffic_allowed": false,
        "rules": [
          {
            "type": "APPLICATION",
            "spec": [
              {
                "application_rule_spec": [
                  {
                    "secured_group_category_associated_entity_type": "VM",
                    "secured_group_category_references": [
                      "${nutanix_category_v2.domain.id}"
                    ],
                    "src_allow_spec": "NONE",
                    "dest_allow_spec": "NONE"
                  }
                ]
              }
            ]
          },
          {
            "type": "INTRA_GROUP",
            "spec": [
              {
                "intra_entity_group_rule_spec": [
                  {
                    "secured_group_category_associated_entity_type": "VM",
                    "secured_group_category_references": [
                      "${nutanix_category_v2.domain.id}"
                    ],
                    "secured_group_action": "DENY"
                  }
                ]
              }
            ]
          }
        ],
        "lifecycle": {
          "prevent_destroy": true,
          "precondition": [
            {
              "condition": "${var.allow_restricted_build && length(trimspace(var.test_authorization_ref)) > 0}",
              "error_message": "Restricted build is not opted in or the external test-authorization reference is missing. No production activation is implemented."
            },
            {
              "condition": "${var.lifecycle_stage == \"prepared\" || length(trimspace(var.bootstrap_acceptance_ref)) > 0}",
              "error_message": "Flow bootstrap requires independent native policy, service-path and withdrawal acceptance."
            }
          ]
        },
        "dynamic": {
          "rules": {
            "for_each": "${var.lifecycle_stage == \"bootstrap\" ? var.bootstrap_rules : {}}",
            "content": {
              "description": "${rules.key}",
              "type": "APPLICATION",
              "spec": [
                {
                  "application_rule_spec": [
                    {
                      "secured_group_category_associated_entity_type": "VM",
                      "secured_group_category_references": [
                        "${nutanix_category_v2.domain.id}"
                      ],
                      "src_allow_spec": "NONE",
                      "dest_allow_spec": "NONE",
                      "is_all_protocol_allowed": false,
                      "src_category_associated_entity_type": "VM",
                      "dest_category_associated_entity_type": "VM",
                      "secured_group_entity_group_reference": "",
                      "src_entity_group_reference": "",
                      "dest_entity_group_reference": "",
                      "network_function_reference": "",
                      "network_function_chain_reference": "",
                      "src_category_references": [],
                      "dest_category_references": [],
                      "src_address_group_references": [],
                      "dest_address_group_references": [],
                      "service_group_references": [],
                      "icmp_services": [],
                      "dynamic": {
                        "src_subnet": {
                          "for_each": "${rules.value.direction == \"ingress\" ? [rules.value.remote_ipv4] : []}",
                          "content": {
                            "value": "${src_subnet.value}",
                            "prefix_length": 32
                          }
                        },
                        "dest_subnet": {
                          "for_each": "${rules.value.direction == \"egress\" ? [rules.value.remote_ipv4] : []}",
                          "content": {
                            "value": "${dest_subnet.value}",
                            "prefix_length": 32
                          }
                        },
                        "tcp_services": {
                          "for_each": "${rules.value.protocol == \"tcp\" ? [rules.value.port] : []}",
                          "content": {
                            "start_port": "${tcp_services.value}",
                            "end_port": "${tcp_services.value}"
                          }
                        },
                        "udp_services": {
                          "for_each": "${rules.value.protocol == \"udp\" ? [rules.value.port] : []}",
                          "content": {
                            "start_port": "${udp_services.value}",
                            "end_port": "${udp_services.value}"
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  },
  "output": {
    "vpc_id": {
      "value": "${nutanix_vpc_v2.domain.ext_id}"
    },
    "subnet_id": {
      "value": "${nutanix_subnet_v2.domain.ext_id}"
    },
    "security_category_id": {
      "value": "${nutanix_category_v2.domain.id}"
    },
    "quarantine_policy_id": {
      "value": "${nutanix_network_security_policy_v2.quarantine.ext_id}"
    },
    "delivery_state": {
      "value": "PREPARED_NOT_QUALIFIED_NOT_SERVICE_READY"
    },
    "lifecycle_stage": {
      "value": "${var.lifecycle_stage}"
    }
  }
}
