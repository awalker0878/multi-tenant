[Unit]
Description=Exact-scope admitted application outbox dispatcher (%i)
After=network-online.target
Wants=network-online.target

[Service]
User=hosting-dispatch
Group=hosting-dispatch
EnvironmentFile=/etc/hosting/workflow/dispatch-%i.env
ExecStart=/opt/hosting/bin/python -m provisioner.controlplane.workflow.runtime dispatch --organization-id ${HOSTING_ORGANIZATION_ID} --tenant-id ${HOSTING_TENANT_ID} --dispatcher-id ${HOSTING_DISPATCHER_ID}
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
