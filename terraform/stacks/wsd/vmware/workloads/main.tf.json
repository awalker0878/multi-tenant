{
  "//": "Generated by scripts/build_wsd_compositions.py; restricted native composition.",
  "terraform": {
    "required_version": ">= 1.7.0, < 2.0.0",
    "required_providers": {
      "vsphere": {
        "source": "hashicorp/vsphere",
        "version": "= 2.12.0"
      }
    },
    "backend": {
      "http": {}
    }
  },
  "provider": {
    "vsphere": {
      "vsphere_server": "${var.platform_endpoint}",
      "user": "${var.platform_username}",
      "password": "${var.platform_password}",
      "allow_unverified_ssl": false
    }
  },
  "variable": {
    "tenant_key": {
      "type": "string",
      "description": "Stable tenant identifier",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,23}$\", var.tenant_key))}",
          "error_message": "Invalid value for Stable tenant identifier."
        }
      ]
    },
    "allow_restricted_build": {
      "type": "bool",
      "description": "Explicit operator opt-in for an authorized non-production build",
      "nullable": false,
      "default": false
    },
    "test_authorization_ref": {
      "type": "string",
      "description": "Reference to separately issued test-scope authorization",
      "nullable": false
    },
    "wsd_key": {
      "type": "string",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,40}$\", var.wsd_key))}",
          "error_message": "A stable WSD identity is required."
        }
      ]
    },
    "environment_key": {
      "type": "string",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,40}$\", var.environment_key))}",
          "error_message": "A stable environment/site identity is required."
        }
      ]
    },
    "site_key": {
      "type": "string",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,40}$\", var.site_key))}",
          "error_message": "A stable environment/site identity is required."
        }
      ]
    },
    "members": {
      "type": "map(object({domain_key = string, vcpu = optional(number, 2), memory_gib = optional(number, 4), boot_disk_gib = optional(number, 40), data_disk_gib = optional(number, 0), accepted_quarantine_ref = string, resource_pool_id = string, datastore_id = string, quarantine_network_id = string, template_uuid = string, guest_id = string, scsi_type = string, firmware = string, storage_policy_id = string}))",
      "nullable": false,
      "description": "workloads owned by this tenant/WSD; map keys are immutable native identities.",
      "validation": [
        {
          "condition": "${length(var.members) > 0}",
          "error_message": "An empty WSD scope is not an allocation or retirement request."
        }
      ]
    },
    "platform_endpoint": {
      "type": "string",
      "description": "vCenter endpoint",
      "nullable": false
    },
    "platform_username": {
      "type": "string",
      "description": "Restricted provider account",
      "nullable": false
    },
    "platform_password": {
      "type": "string",
      "description": "Credential injected at execution",
      "nullable": false,
      "sensitive": true
    }
  },
  "module": {
    "owned": {
      "source": "../../../../compositions/vmware/workloads",
      "tenant_key": "${var.tenant_key}",
      "allow_restricted_build": "${var.allow_restricted_build}",
      "test_authorization_ref": "${var.test_authorization_ref}",
      "wsd_key": "${var.wsd_key}",
      "environment_key": "${var.environment_key}",
      "site_key": "${var.site_key}",
      "members": "${var.members}"
    }
  },
  "output": {
    "scope": {
      "value": "${module.owned.scope}"
    },
    "members": {
      "value": "${module.owned.members}"
    },
    "delivery_state": {
      "value": "${module.owned.delivery_state}"
    }
  }
}
