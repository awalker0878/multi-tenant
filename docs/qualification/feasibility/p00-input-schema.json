  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uri",
        "sha256",
        "revision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "repository",
            "protected"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "evidence",
        "observed_at",
        "observed_by",
        "scope",
        "review"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNKNOWN",
            "PROPOSED",
            "OBSERVED",
            "BLOCKED"
          ]
        },
        "value": {
          "type": [
            "null",
            "string",
            "boolean",
            "number"
          ],
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "observed_by": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "scope": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "campaign",
            "resource_ids"
          ],
          "properties": {
            "campaign": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            },
            "resource_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disposition",
            "reviewed_by",
            "reviewed_at"
          ],
          "properties": {
            "disposition": {
              "enum": [
                "NOT_REVIEWED",
                "ACCEPTED",
                "REJECTED"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "reviewed_at": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        }
      }
    }
  },
