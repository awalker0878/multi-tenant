{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "method": {
      "enum": [
        "APPLICATION_REBUILD_RESTORE",
        "VM_SNAPSHOT_BASELINE_APP_DELTA",
        "VM_SNAPSHOT_BASELINE_FILE_DELTA",
        "VM_COLD_EXPORT",
        "EXTERNAL_BLOCK_REPLICATION"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "native_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tuple_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "profile_sha256",
        "native_identity_sha256",
        "tuple_sha256",
        "observed_at",
        "expires_at"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "native_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tuple_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "profile_sha256",
        "native_identity_sha256",
        "tuple_sha256",
        "observed_at",
        "expires_at"
      ]
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "disk_keys": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "maxItems": 32,
            "minItems": 1,
            "uniqueItems": true
          },
          "mounts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "maxItems": 32,
            "minItems": 1
          },
          "consistency_group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "validation_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "id",
          "name",
          "disk_keys",
          "mounts",
          "consistency_group",
          "validation_reference"
        ]
      },
      "maxItems": 256
    },
    "disks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "capacity_bytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "controller_key": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "unit_number": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "backing_chain": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 240
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "mode": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 240
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "identity_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "encrypted": {
                  "type": "boolean"
                },
                "datastore": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "type": "string",
                          "maxLength": 240
                        },
                        "value": {
                          "type": "string",
                          "maxLength": 240
                        }
                      },
                      "required": [
                        "type",
                        "value"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sharing": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 240
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "type",
                "mode",
                "identity_sha256",
                "encrypted",
                "datastore",
                "sharing"
              ]
            },
            "maxItems": 32
          },
          "native_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "key",
          "capacity_bytes",
          "controller_key",
          "unit_number",
          "backing_chain",
          "native_sha256"
        ]
      },
      "maxItems": 32
    },
    "owner_inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "application_consistency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "dependencies": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "guest_transformation_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "delta_protocol": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240
        },
        "recovery_protocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "service_and_policy_validation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "writer_fencing": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "retention_and_cleanup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "required": [
        "application_consistency",
        "dependencies",
        "guest_transformation_profile",
        "delta_protocol",
        "recovery_protocol",
        "service_and_policy_validation",
        "writer_fencing",
        "retention_and_cleanup"
      ]
    },
    "objectives": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "type": "string",
          "format": "uuid"
        },
        "acceptance_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "max_outage_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "max_data_loss_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "owner_id",
        "acceptance_sha256",
        "max_outage_seconds",
        "max_data_loss_bytes"
      ]
    },
    "confirmed_by": {
      "type": "string",
      "format": "uuid"
    },
    "current": {
      "const": true
    },
    "native_write_authorized": {
      "const": false
    },
    "target_disk_formats": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 30
    },
    "destination": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": {
              "const": "ahv"
            },
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "prism_central_id": {
              "type": "string",
              "format": "uuid"
            },
            "cluster_id": {
              "type": "string",
              "format": "uuid"
            },
            "vpc_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "storage_container_id": {
              "type": "string",
              "format": "uuid"
            },
            "category_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1,
              "maxItems": 32
            },
            "policy_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1,
              "maxItems": 32
            },
            "firmware": {
              "enum": [
                "bios",
                "efi"
              ]
            },
            "disks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_key": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 31
                  }
                },
                "required": [
                  "source_key",
                  "index"
                ]
              },
              "minItems": 1,
              "maxItems": 32
            },
            "nics": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_key": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "quarantine_subnet_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "production_subnet_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "source_key",
                  "quarantine_subnet_id",
                  "production_subnet_id"
                ]
              },
              "minItems": 0,
              "maxItems": 32
            }
          },
          "required": [
            "platform",
            "project_id",
            "prism_central_id",
            "cluster_id",
            "vpc_id",
            "storage_container_id",
            "category_ids",
            "policy_ids",
            "firmware",
            "disks",
            "nics"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": {
              "const": "vmware"
            },
            "project_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "vcenter_uuid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "folder_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "resource_pool_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "host_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "datastore_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "guest_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 85
            },
            "hardware_version": {
              "type": "string",
              "pattern": "^vmx-[0-9]{2}$"
            },
            "firmware": {
              "enum": [
                "bios",
                "efi"
              ]
            },
            "disks": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_key": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 31
                  }
                },
                "required": [
                  "source_key",
                  "index"
                ]
              },
              "minItems": 1,
              "maxItems": 32
            },
            "nics": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_key": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "quarantine_network_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
                  },
                  "production_network_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
                  }
                },
                "required": [
                  "source_key",
                  "quarantine_network_id",
                  "production_network_id"
                ]
              },
              "minItems": 0,
              "maxItems": 32
            }
          },
          "required": [
            "platform",
            "project_id",
            "vcenter_uuid",
            "folder_id",
            "resource_pool_id",
            "host_id",
            "datastore_id",
            "guest_id",
            "hardware_version",
            "firmware",
            "disks",
            "nics"
          ]
        }
      ]
    },
    "source_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_identity_sha256",
        "generation_id",
        "profile_sha256",
        "installed_tuple_sha256",
        "installation_id",
        "native_scope",
        "current",
        "expires_at",
        "holds",
        "facts",
        "owner_dataset_coverage_current",
        "network_semantics_independently_verified",
        "native_write_authorized",
        "observation_sha256"
      ],
      "properties": {
        "source_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generation_id": {
          "type": "string",
          "format": "uuid"
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "installed_tuple_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "installation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "current": {
          "type": "boolean"
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "holds": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string"
          }
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory_mb",
            "firmware",
            "secure_boot",
            "disks",
            "nics",
            "native"
          ],
          "properties": {
            "cpu": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "memory_mb": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "firmware": {
              "type": [
                "string",
                "null"
              ]
            },
            "secure_boot": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "disks": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "capacity_bytes"
                ],
                "properties": {
                  "key": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "capacity_bytes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            },
            "nics": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key"
                ],
                "properties": {
                  "key": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              }
            },
            "native": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "identity"
              ],
              "properties": {
                "identity": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "owner_dataset_coverage_current": {
          "const": false
        },
        "network_semantics_independently_verified": {
          "const": false
        },
        "native_write_authorized": {
          "const": false
        },
        "observation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "required": [
    "tenant_id",
    "site_id",
    "revision",
    "digest",
    "method",
    "source",
    "target",
    "datasets",
    "disks",
    "owner_inputs",
    "objectives",
    "confirmed_by",
    "current",
    "native_write_authorized",
    "target_disk_formats"
  ]
}
