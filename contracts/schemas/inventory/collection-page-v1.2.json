{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "discovery_id",
    "lease_token",
    "sequence",
    "observations",
    "next_cursor",
    "terminal",
    "coverage",
    "collected_at",
    "error"
  ],
  "properties": {
    "discovery_id": {
      "type": "string",
      "format": "uuid"
    },
    "lease_token": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "observations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/Observation"
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal": {
      "type": "boolean"
    },
    "coverage": {
      "type": "boolean"
    },
    "collected_at": {
      "type": "number"
    },
    "error": {
      "anyOf": [
        {
          "enum": [
            "transport_unavailable",
            "throttled",
            "permission_denied",
            "invalid_response",
            "unsafe_destination",
            "unsupported_api",
            "source_changed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "status",
        "items"
      ],
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 80
        },
        "status": {
          "enum": [
            "observed",
            "permission_denied",
            "unsupported_api",
            "transport_unavailable",
            "throttled",
            "invalid_response"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 200
              },
              "name": {
                "type": "string",
                "maxLength": 255
              },
              "attributes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "key": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "key",
                    "value"
                  ]
                },
                "maxItems": 20
              }
            },
            "required": [
              "id",
              "name",
              "attributes"
            ]
          }
        }
      }
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceWorkloadProfile"
        },
        {
          "$ref": "#/$defs/TargetCapabilityProfile"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-tenant.invalid/contracts/inventory/collection-page-v1.2",
  "$defs": {
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "native_id",
        "incarnation",
        "name",
        "scope",
        "facts"
      ],
      "properties": {
        "kind": {
          "enum": [
            "server",
            "network",
            "volume",
            "datastore"
          ]
        },
        "native_id": {
          "type": "string",
          "maxLength": 255
        },
        "incarnation": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 255
        },
        "scope": {
          "type": "string",
          "maxLength": 255
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "power": {
              "type": "string",
              "maxLength": 255
            },
            "cpu": {
              "type": "integer",
              "minimum": 0
            },
            "memory_mib": {
              "type": "integer",
              "minimum": 0
            },
            "size_gib": {
              "type": "integer",
              "minimum": 0
            },
            "status": {
              "type": "string",
              "maxLength": 255
            }
          }
        }
      }
    },
    "SourceWorkloadProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instance_uuid": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "bios_uuid": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "vcenter_uuid": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "vcenter_version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "native_api_version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "power_state": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "guest_id": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "tools_status": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "tools_version": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "firmware": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": 1
        },
        "profile_type": {
          "const": "SourceWorkloadProfile"
        },
        "platform": {
          "const": "vmware"
        },
        "vm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "api_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observations_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cpu": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "memory_mb": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "disks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "capacity_bytes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "controller_key": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit_number": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "backing_chain": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 240
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "mode": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 240
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "identity_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "encrypted": {
                      "type": "boolean"
                    },
                    "datastore": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "type": {
                              "type": "string",
                              "maxLength": 240
                            },
                            "value": {
                              "type": "string",
                              "maxLength": 240
                            }
                          },
                          "required": [
                            "type",
                            "value"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sharing": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 240
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "mode",
                    "identity_sha256",
                    "encrypted",
                    "datastore",
                    "sharing"
                  ]
                },
                "maxItems": 32
              },
              "native_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "key",
              "capacity_bytes",
              "controller_key",
              "unit_number",
              "backing_chain",
              "native_sha256"
            ]
          },
          "maxItems": 32
        },
        "nics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "model": {
                "type": "string",
                "maxLength": 240
              },
              "mac": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 240
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "backing_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "connectable": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "connected": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "startConnected": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "allowGuestControl": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "connected",
                  "startConnected",
                  "allowGuestControl"
                ]
              }
            },
            "required": [
              "key",
              "model",
              "mac",
              "backing_sha256",
              "connectable"
            ]
          },
          "maxItems": 128
        },
        "controllers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "model": {
                "type": "string",
                "maxLength": 240
              },
              "bus": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sharing": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 240
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "key",
              "model",
              "bus",
              "sharing"
            ]
          },
          "maxItems": 128
        },
        "snapshot_tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "key_custody_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "required_owner_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "maxItems": 20
        },
        "holds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "maxItems": 64
        },
        "native_qualification": {
          "const": "not_established"
        }
      },
      "required": [
        "instance_uuid",
        "bios_uuid",
        "vcenter_uuid",
        "vcenter_version",
        "native_api_version",
        "power_state",
        "guest_id",
        "tools_status",
        "tools_version",
        "firmware",
        "schema_version",
        "profile_type",
        "platform",
        "vm_id",
        "api_version",
        "config_sha256",
        "observations_sha256",
        "observed_at",
        "cpu",
        "memory_mb",
        "disks",
        "nics",
        "controllers",
        "snapshot_tree_sha256",
        "key_custody_sha256",
        "required_owner_inputs",
        "holds",
        "native_qualification"
      ]
    },
    "TargetCapabilityProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "profile_type": {
          "const": "TargetCapabilityProfile"
        },
        "platform": {
          "const": "openstack"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observations_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "disk_formats": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "maxItems": 30
        },
        "image_import_methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "maxItems": 30
        },
        "flavors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 240
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "vcpus": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ram": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "disk": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "OS-FLV-EXT-DATA:ephemeral": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "vcpus",
              "ram",
              "disk",
              "OS-FLV-EXT-DATA:ephemeral"
            ]
          },
          "maxItems": 100
        },
        "volume_types": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 240
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "is_public": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "constraints_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "is_public",
              "constraints_sha256"
            ]
          },
          "maxItems": 100
        },
        "network_extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "maxItems": 100
        },
        "compute_version": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_version": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 240
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 240
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "min_version",
            "version"
          ]
        },
        "volume_version": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_version": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 240
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 240
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "min_version",
            "version"
          ]
        },
        "required_capability_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "maxItems": 20
        },
        "holds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "maxItems": 64
        },
        "native_qualification": {
          "const": "not_established"
        }
      },
      "required": [
        "schema_version",
        "profile_type",
        "platform",
        "project_id",
        "observed_at",
        "observations_sha256",
        "disk_formats",
        "image_import_methods",
        "flavors",
        "volume_types",
        "network_extensions",
        "compute_version",
        "volume_version",
        "required_capability_evidence",
        "holds",
        "native_qualification"
      ]
    }
  }
}
