                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "boot": {
                        "type": "boolean"
                      },
                      "dataset_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "encryption": {
                        "enum": [
                          "required",
                          "preferred",
                          "optional"
                        ]
                      }
