APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_KEY=
LOG_LEVEL=info
# Process health is separate from domain and deployment readiness.
# The API uses catalogue / catalogue_runtime and mounted secrets only.
DB_HOST=unconfigured.invalid
DB_PASSWORD_FILE=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/secrets/postgres-ca.crt
GOVERNANCE_URL=
GOVERNANCE_CA_FILE=
GOVERNANCE_CREDENTIAL_FILE=
CONSOLE_CATALOGUE_CREDENTIAL_FILE=
CATALOGUE_BROKER_HOST=
CATALOGUE_BROKER_PORT=5671
CATALOGUE_BROKER_PASSWORD_FILE=
CATALOGUE_BROKER_CA_FILE=

# Restricted read-only current-planning-intent service callers
PLANNING_CALLER_CREDENTIAL_FILE=
LIFECYCLE_CALLER_CREDENTIAL_FILE=
