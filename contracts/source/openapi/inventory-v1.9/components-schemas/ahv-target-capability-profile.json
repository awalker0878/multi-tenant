    "required": [
      "schema_version",
      "profile_type",
      "platform",
      "project_id",
      "prism_central_id",
      "cluster_id",
      "cluster_name",
      "api_versions",
      "installed",
      "observed_at",
      "observations_sha256",
      "inventory_complete",
      "disk_formats",
      "image_import_methods",
      "required_capability_evidence",
      "holds",
      "native_qualification",
      "storage_containers",
      "subnets",
      "vpcs",
      "categories",
      "policies",
      "security_references"
    ]
  }
}
