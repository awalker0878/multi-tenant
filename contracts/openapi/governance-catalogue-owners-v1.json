{
  "openapi": "3.1.0",
  "info": {
    "title": "Governance Catalogue owner validation",
    "version": "1.0.0",
    "description": "Catalogue workload only; the matching current actor delegation is resolved for this exact tenant/action/scope before checking active owners. This result is request-bound, never a reusable authorization grant."
  },
  "paths": {
    "/v1/tenants/{tenant}/catalogue-owner-checks": {
      "post": {
        "operationId": "checkCatalogueOwners",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            }
          }
        ],
        "security": [
          {
            "CatalogueWorkload": [],
            "ActorDelegation": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OwnerCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current bounded owners, sorted by opaque actor ID; no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OwnerCheckResult"
                }
              }
            }
          },
          "default": {
            "description": "Invalid, unavailable or denied workload, delegation, tenant, owner or scope; no-store."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CatalogueWorkload": {
        "type": "http",
        "scheme": "bearer"
      },
      "ActorDelegation": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Actor-Delegation"
      }
    },
    "schemas": {
      "OwnerCheckRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "scope",
          "owners"
        ],
        "properties": {
          "action": {
            "enum": [
              "application.write",
              "reference.write"
            ]
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "site_id",
              "environment",
              "resource_id"
            ],
            "properties": {
              "site_id": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "environment": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "resource_id": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 128
              }
            }
          },
          "owners": {
            "type": "array",
            "minItems": 1,
            "maxItems": 301,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            }
          }
        }
      },
      "OwnerCheckResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allowed",
          "tenant_id",
          "owners"
        ],
        "properties": {
          "allowed": {
            "const": true
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "owners": {
            "type": "array",
            "minItems": 1,
            "maxItems": 301,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$"
            }
          }
        }
      }
    }
  }
}
