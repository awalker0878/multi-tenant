{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:product:catalogue:foundation-recorded:1",
  "title": "CatalogueFoundationRecordedV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_type": {
      "type": "string",
      "const": "catalogue.foundation.recorded"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,17}$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "required": [
    "event_type",
    "schema_version",
    "event_id",
    "correlation_id",
    "tenant_id",
    "actor_id",
    "record_id",
    "revision",
    "payload_sha256",
    "source_revision",
    "occurred_at"
  ]
}
