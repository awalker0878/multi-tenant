{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hosting.platform/v1/resolved-desired-state",
  "title": "Resolved desired state",
  "description": "Fully resolved intent. No auto value, no unexpanded domain and no native mutation remain. Capacity, address and service bindings are declared, not confirmed.",
  "type": "object",
  "required": ["format", "status", "request_digest", "apiVersion", "kind", "tenant", "wsd",
               "environment", "site", "platform", "platform_family", "trust", "service_class",
               "generation", "profiles", "profile_versions", "catalog_versions", "catalog_digest",
               "policy", "placement", "capabilities", "services",
               "service_bindings", "reservations", "clusters", "domains", "native_contact",
               "digest"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "hosting-resolved-desired-state/1"},
    "status": {"const": "RESOLVED_DISABLED_NOT_AUTHORIZED"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "apiVersion": {"const": "hosting.platform/v1"},
    "kind": {"const": "WorkloadSecurityDomain"},
    "tenant": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,23}$"},
    "wsd": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"},
    "owner": {"type": "string"},
    "environment": {"type": "string"},
    "site": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"},
    "platform": {"enum": ["nutanix", "vmware", "openstack"]},
    "platform_family": {"type": "string"},
    "trust": {"type": "string"},
    "service_class": {"type": "string"},
    "generation": {"type": "integer", "minimum": 1,
                   "description": "Monotonic desired-state generation for this WSD identity."},
    "profiles": {"type": "object", "minProperties": 1},
    "profile_versions": {"type": "object", "minProperties": 1,
                         "description": "The reviewed revision of every resolved profile."},
    "catalog_versions": {"type": "object", "minProperties": 1,
                         "description": "The reviewed revision of every profile catalog."},
    "catalog_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$",
                       "description": "Canonical digest of the whole reviewed catalog set."},
    "policy": {"type": "object"},
    "placement": {"type": "object", "minProperties": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true,
                     "minItems": 1},
    "services": {"type": "object"},
    "service_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["format", "service", "profile", "binding_class", "site", "endpoints",
                     "status"],
        "additionalProperties": false,
        "properties": {
          "format": {"const": "hosting-service-binding/1"},
          "service": {"type": "string"},
          "profile": {"type": "string"},
          "binding_class": {"type": "string"},
          "site": {"type": "string"},
          "endpoints": {"type": "object"},
          "status": {"enum": ["DECLARED_HANDOFF_NOT_VERIFIED"]},
          "limits": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "reservations": {"type": "object"},
    "clusters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "zone", "trust", "service_classes", "eligible_tenants",
                     "dedicated_wsd", "host_ids", "native"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"},
          "role": {"type": "string"},
          "zone": {"enum": ["OZ", "RZ"]},
          "trust": {"type": "string"},
          "service_classes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "eligible_tenants": {"type": "array", "items": {"type": "string"}},
          "dedicated_wsd": {"type": ["string", "null"]},
          "host_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "native": {"type": "object", "minProperties": 1}
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "zone", "cell", "cluster", "prefix", "gateway_host_number",
                     "inputs", "workloads"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{1,23}$"},
          "zone": {"enum": ["OZ", "RZ"]},
          "cell": {"type": "string"},
          "cluster": {"type": "string"},
          "prefix": {"type": "string"},
          "gateway_host_number": {"type": "integer", "minimum": 1},
          "inputs": {"type": "object"},
          "workloads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "address", "vcpu", "memory_gib", "boot_disk_gib",
                           "data_disk_gib", "inputs"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"},
                "address": {"type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"},
                "vcpu": {"type": "integer", "minimum": 1},
                "memory_gib": {"type": "integer", "minimum": 1},
                "boot_disk_gib": {"type": "integer", "minimum": 1},
                "data_disk_gib": {"type": "integer", "minimum": 0},
                "inputs": {"type": "object"}
              }
            }
          }
        }
      }
    },
    "native_contact": {"const": false},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "limits": {"type": "array", "items": {"type": "string"}}
  }
}