{
  "//": "Original implementation, increment 01. RESTRICTED QUARANTINE ONLY. Native provider validation and target tests are outstanding.",
  "terraform": {
    "required_version": ">= 1.7.0, < 2.0.0",
    "required_providers": {
      "vsphere": {
        "source": "hashicorp/vsphere",
        "version": "= 2.12.0"
      }
    }
  },
  "variable": {
    "tenant_key": {
      "type": "string",
      "description": "Stable tenant identifier",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,23}$\", var.tenant_key))}",
          "error_message": "Invalid value for Stable tenant identifier."
        }
      ]
    },
    "domain_key": {
      "type": "string",
      "description": "Stable domain identifier",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[A-Za-z][A-Za-z0-9-]{1,23}$\", var.domain_key))}",
          "error_message": "Invalid value for Stable domain identifier."
        }
      ]
    },
    "allow_restricted_build": {
      "type": "bool",
      "description": "Explicit operator opt-in for an authorized non-production build",
      "nullable": false,
      "default": false
    },
    "test_authorization_ref": {
      "type": "string",
      "description": "Reference to separately issued test-scope authorization",
      "nullable": false
    },
    "workload_key": {
      "type": "string",
      "description": "Owned workload identity",
      "nullable": false,
      "validation": [
        {
          "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,40}$\", var.workload_key))}",
          "error_message": "Invalid value for Owned workload identity."
        }
      ]
    },
    "vcpu": {
      "type": "number",
      "description": "Requested guest vCPU",
      "nullable": false,
      "default": 2,
      "validation": [
        {
          "condition": "${var.vcpu >= 1 && floor(var.vcpu) == var.vcpu}",
          "error_message": "Invalid value for Requested guest vCPU."
        }
      ]
    },
    "memory_gib": {
      "type": "number",
      "description": "Requested guest memory in GiB",
      "nullable": false,
      "default": 4,
      "validation": [
        {
          "condition": "${var.memory_gib >= 1 && floor(var.memory_gib) == var.memory_gib}",
          "error_message": "Invalid value for Requested guest memory in GiB."
        }
      ]
    },
    "boot_disk_gib": {
      "type": "number",
      "description": "Requested boot disk GiB; must be at least image/template size",
      "nullable": false,
      "default": 40,
      "validation": [
        {
          "condition": "${var.boot_disk_gib >= 1 && floor(var.boot_disk_gib) == var.boot_disk_gib}",
          "error_message": "Invalid value for Requested boot disk GiB; must be at least image/template size."
        }
      ]
    },
    "data_disk_gib": {
      "type": "number",
      "description": "Owned optional data disk GiB; zero omits",
      "nullable": false,
      "default": 0,
      "validation": [
        {
          "condition": "${var.data_disk_gib >= 0 && floor(var.data_disk_gib) == var.data_disk_gib}",
          "error_message": "Invalid value for Owned optional data disk GiB; zero omits."
        }
      ]
    },
    "accepted_quarantine_ref": {
      "type": "string",
      "description": "Scoped independently reviewed network/policy/placement handoff reference",
      "nullable": false
    },
    "resource_pool_id": {
      "type": "string",
      "description": "Accepted zone-eligible resource-pool managed object ID",
      "nullable": false
    },
    "datastore_id": {
      "type": "string",
      "description": "Accepted datastore managed object ID",
      "nullable": false
    },
    "quarantine_network_id": {
      "type": "string",
      "description": "vCenter network ID mapped to the accepted NSX quarantine segment",
      "nullable": false
    },
    "template_uuid": {
      "type": "string",
      "description": "Approved single-boot-disk single-NIC template UUID",
      "nullable": false
    },
    "guest_id": {
      "type": "string",
      "description": "Guest OS ID matching the approved template",
      "nullable": false
    },
    "scsi_type": {
      "type": "string",
      "description": "SCSI controller type matching the template",
      "nullable": false
    },
    "firmware": {
      "type": "string",
      "description": "Template firmware",
      "nullable": false,
      "validation": [
        {
          "condition": "${contains([\"bios\", \"efi\"], var.firmware)}",
          "error_message": "Invalid value for Template firmware."
        }
      ]
    },
    "storage_policy_id": {
      "type": "string",
      "description": "Accepted storage policy ID",
      "nullable": false
    }
  },
  "resource": {
    "vsphere_virtual_machine": {
      "workload": {
        "name": "${var.workload_key}",
        "resource_pool_id": "${var.resource_pool_id}",
        "datastore_id": "${var.datastore_id}",
        "storage_policy_id": "${var.storage_policy_id}",
        "annotation": "${var.tenant_key}/${var.domain_key}; restricted qualification only.",
        "num_cpus": "${var.vcpu}",
        "memory": "${var.memory_gib * 1024}",
        "guest_id": "${var.guest_id}",
        "scsi_type": "${var.scsi_type}",
        "firmware": "${var.firmware}",
        "wait_for_guest_net_timeout": 0,
        "wait_for_guest_ip_timeout": 0,
        "network_interface": [
          {
            "network_id": "${var.quarantine_network_id}",
            "adapter_type": "vmxnet3"
          }
        ],
        "disk": [
          {
            "label": "disk0",
            "size": "${var.boot_disk_gib}",
            "unit_number": 0,
            "thin_provisioned": true,
            "keep_on_remove": true,
            "storage_policy_id": "${var.storage_policy_id}"
          }
        ],
        "dynamic": {
          "disk": {
            "for_each": "${var.data_disk_gib > 0 ? [var.data_disk_gib] : []}",
            "content": {
              "label": "data0",
              "size": "${disk.value}",
              "unit_number": 1,
              "thin_provisioned": true,
              "keep_on_remove": true,
              "storage_policy_id": "${var.storage_policy_id}"
            }
          }
        },
        "clone": [
          {
            "template_uuid": "${var.template_uuid}",
            "linked_clone": false
          }
        ],
        "lifecycle": {
          "prevent_destroy": true,
          "precondition": [
            {
              "condition": "${var.allow_restricted_build && length(trimspace(var.test_authorization_ref)) > 0}",
              "error_message": "Restricted build is not opted in or the external test-authorization reference is missing. No production activation is implemented."
            },
            {
              "condition": "${length(trimspace(var.accepted_quarantine_ref)) > 0}",
              "error_message": "A separately reviewed quarantine/placement handoff is required. A reference string is not proof of approval."
            }
          ]
        }
      }
    }
  },
  "output": {
    "vm_id": {
      "value": "${vsphere_virtual_machine.workload.id}"
    },
    "observed_power_state": {
      "value": "${vsphere_virtual_machine.workload.power_state}"
    },
    "delivery_state": {
      "value": "PREPARED_NOT_QUALIFIED_NOT_SERVICE_READY"
    }
  }
}
