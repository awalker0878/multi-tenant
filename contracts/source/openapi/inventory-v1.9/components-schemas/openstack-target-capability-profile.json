{
  "OpenStackTargetCapabilityProfile": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": 1
      },
      "profile_type": {
        "const": "TargetCapabilityProfile"
      },
      "platform": {
        "const": "openstack"
      },
      "project_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "observed_at": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "observations_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "disk_formats": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "maxItems": 30
      },
      "image_import_methods": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "maxItems": 30
      },
      "flavors": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 240
                },
                {
                  "type": "null"
                }
              ]
            },
            "vcpus": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "ram": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "disk": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "OS-FLV-EXT-DATA:ephemeral": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "vcpus",
            "ram",
            "disk",
            "OS-FLV-EXT-DATA:ephemeral"
          ]
        },
        "maxItems": 100
      },
      "volume_types": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 240
                },
                {
                  "type": "null"
                }
              ]
            },
            "is_public": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "constraints_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "is_public",
            "constraints_sha256"
          ]
        },
        "maxItems": 100
      },
      "network_extensions": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "maxItems": 100
      },
      "security_groups": {
        "type": "array",
        "maxItems": 99,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "name": {
              "type": "string",
              "maxLength": 240
            },
            "project_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "stateful": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "rules_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "semantics_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "rules": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      "direction": {
                        "enum": [
                          "ingress",
                          "egress"
                        ]
                      },
                      "ethertype": {
                        "enum": [
                          "IPv4",
                          "IPv6"
                        ]
                      },
                      "protocol": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "port_range_min": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 65535
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "port_range_max": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 65535
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "remote_ip_prefix": {
                        "anyOf": [
                          {
                            "type": "string",
                            "maxLength": 128
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "semantic_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "id",
                      "direction",
                      "ethertype",
                      "protocol",
                      "port_range_min",
                      "port_range_max",
                      "remote_ip_prefix",
                      "semantic_sha256"
                    ]
                  },
                  "maxItems": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "native_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "name",
            "project_id",
            "stateful",
            "rules_sha256",
            "semantics_sha256",
            "rules",
            "native_sha256"
          ]
        }
      },
      "compute_version": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "min_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 240
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 240
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "min_version",
          "version"
        ]
      },
      "volume_version": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "min_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 240
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 240
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "min_version",
          "version"
        ]
      },
      "required_capability_evidence": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "maxItems": 20
      },
      "holds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "maxItems": 64
      },
      "native_qualification": {
        "const": "not_established"
      }
    },
    "required": [
      "schema_version",
      "profile_type",
      "platform",
      "project_id",
      "observed_at",
      "observations_sha256",
      "disk_formats",
      "image_import_methods",
      "flavors",
      "volume_types",
      "network_extensions",
      "security_groups",
      "compute_version",
      "volume_version",
      "required_capability_evidence",
      "holds",
      "native_qualification"
    ]
  }
}
