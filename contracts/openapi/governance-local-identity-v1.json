  },
  "components": {
    "securitySchemes": {
      "ConsoleWorkload": {
        "type": "http",
        "scheme": "bearer",
        "description": "Independent mounted Console workload credential; not a health token."
      },
      "ConsoleSession": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Console-Session",
        "description": "Opaque user authority retained only in the encrypted server-side console session."
      }
    },
    "schemas": {
      "LocalIdentity": {
        "type": "object",
        "required": [
          "subject",
          "password_change_required",
          "permissions"
        ],
        "additionalProperties": false,
        "properties": {
          "subject": {
            "const": "bootstrap-admin"
          },
          "password_change_required": {
            "type": "boolean"
          },
          "permissions": {
            "type": "array",
            "items": {
              "enum": [
                "identity.password.change",
                "identity.logout",
                "identity.setup"
              ]
            }
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "session_token",
          "expires_at",
          "identity"
        ],
        "additionalProperties": false,
        "properties": {
          "session_token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Opaque, console-audience credential; server-side custody only. Persisted as SHA-256 in Governance."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "identity": {
            "$ref": "#/components/schemas/LocalIdentity"
          }
        }
      },
      "CurrentIdentity": {
        "type": "object",
        "required": [
          "identity"
        ],
        "additionalProperties": false,
        "properties": {
          "identity": {
            "$ref": "#/components/schemas/LocalIdentity"
          }
        }
      },
      "Setup": {
        "type": "object",
        "required": [
          "identity",
          "oidc"
        ],
        "additionalProperties": false,
        "properties": {
          "identity": {
            "$ref": "#/components/schemas/LocalIdentity"
          },
          "oidc": {
            "type": "object",
            "required": [
              "state"
            ],
            "additionalProperties": false,
            "properties": {
              "state": {
                "enum": ["not_configured", "awaiting_verification", "active"]
              }
            }
          }
        }
      },
      "Logout": {
        "type": "object",
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "signed_out"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object"
          }
        },
        "anyOf": [
          {
            "required": [
              "error"
            ]
          },
          {
            "required": [
              "message"
            ]
          }
        ]
      },
      "Login": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 128
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 512
          }
        }
      },
      "PasswordChange": {
        "type": "object",
        "required": [
          "current_password",
          "password",
          "password_confirmation"
        ],
        "properties": {
          "current_password": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 512
          },
          "password": {
            "type": "string",
            "writeOnly": true,
            "minLength": 15,
            "maxLength": 128
          },
          "password_confirmation": {
            "type": "string",
            "writeOnly": true,
            "minLength": 15,
            "maxLength": 128
          }
        }
      }
    }
  }
}
