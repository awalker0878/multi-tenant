{
  "openapi": "3.1.0",
  "info": {
    "title": "Current Inventory collection admission",
    "version": "1.1.0",
    "description": " Statuses now explicitly include controller, middleware and Laravel validation/HTTP exception behavior; no new authority is granted."
  },
  "paths": {
    "/v1/tenants/{tenant}/inventory-collection-checks": {
      "post": {
        "operationId": "checkInventoryCollection",
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner_id",
                  "site_id",
                  "policy_digest"
                ],
                "properties": {
                  "owner_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "site_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "policy_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current owner and tenant admission; not endpoint or native-write authority",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "allowed",
                    "tenant_id",
                    "owner_id",
                    "site_id",
                    "policy_digest",
                    "evaluated_at",
                    "native_write_authorized"
                  ],
                  "properties": {
                    "allowed": {
                      "const": true
                    },
                    "tenant_id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "owner_id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "site_id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "policy_digest": {
                      "type": "string",
                      "maxLength": 255
                    },
                    "evaluated_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "native_write_authorized": {
                      "const": false
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "HTTP 401: owner authorization, validation, current resource or dependency failure; no native grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "HTTP 403: owner authorization, validation, current resource or dependency failure; no native grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "HTTP 422: owner authorization, validation, current resource or dependency failure; no native grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "HTTP 503: owner authorization, validation, current resource or dependency failure; no native grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "InventoryWorkload": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "error": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": true
          },
          "field": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "required": [
              "error"
            ]
          },
          {
            "required": [
              "message"
            ]
          }
        ]
      }
    }
  },
  "security": [
    {
      "InventoryWorkload": []
    }
  ]
}
