[Unit]
Description=Enrolled PostgreSQL fleet discovery batch %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=hosting-discovery
Group=hosting-discovery
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONSAFEPATH=1
StateDirectory=hosting-discovery/fleet-batches/%i hosting-discovery/outbox
StateDirectoryMode=0700
ExecStartPre=/opt/hosting/bin/hosting-discovery-fleet inspect --config /etc/hosting/discovery/fleets/%i.json
ExecStart=/opt/hosting/bin/hosting-discovery-collect batch-run --config /etc/hosting/discovery/batches/%i.json --state-directory /var/lib/hosting-discovery/fleet-batches/%i --fleet-config /etc/hosting/discovery/fleets/%i.json
ExecStartPost=/opt/hosting/bin/hosting-discovery-collect batch-publish --config /etc/hosting/discovery/batches/%i.json --state-directory /var/lib/hosting-discovery/fleet-batches/%i
TimeoutStartSec=70min
KillMode=control-group
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
