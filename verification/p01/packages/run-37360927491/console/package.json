    "test:boundaries": "node --experimental-strip-types tests/architecture/frontend-boundaries.ts"
  },
  "dependencies": {
    "@inertiajs/vue3": "3.8.0",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@inertiajs/vite": "3.8.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "laravel-vite-plugin": "3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vue-tsc": "3.3.12"
  }
}
