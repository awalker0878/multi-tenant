{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision_id",
    "intent_sha256",
    "intent"
  ],
  "properties": {
    "revision_id": {
      "type": "string",
      "format": "uuid"
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intent": {
      "type": "object",
      "required": [
        "workloads",
        "datasets",
        "dependencies",
        "environment"
      ]
    }
  }
}
