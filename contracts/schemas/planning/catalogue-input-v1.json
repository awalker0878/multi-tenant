                      "maxLength": 128
                    },
                    "mode": {
                      "enum": [
                        "affinity",
                        "anti_affinity",
                        "independent"
                      ]
                    },
                    "strength": {
                      "enum": [
                        "required",
                        "preferred",
                        "optional"
                      ]
                    }
                  },
                  "required": [
                    "group",
                    "mode",
                    "strength"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "role",
                "wsd",
                "security_domain",
                "compute",
                "guest",
                "disks",
                "nics",
                "requirements",
