{
  "openapi": "3.1.0",
  "info": {
    "title": "Commissioned migration data method owner protocol",
    "version": "2.0.0",
    "description": "Application backup/restore, application delta, file metadata delta and storage block replication use separate typed operations. Native VM disk adapters do not implement these data-system methods. Every direction, mechanism version, dataset and recovery procedure needs exact qualification; E2 tests do not grant E3/E4 support."
  },
  "security": [
    {
      "OwnerBearer": []
    }
  ],
  "paths": {
    "/v2/migration/method-effects": {
      "post": {
        "operationId": "submitCommissionedDataMethod",
        "description": "Enrolled product owner protocol. Exact method, dataset, source/destination identities and limits must be implemented and qualified by the owner. No retry of uncertain data mutations; independent observations remain available without effect authority. Payloads are bounded to 131072 bytes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MethodEffectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bound receipt; submission never establishes readiness or write admission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MethodEffectReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Operation held; unknown submissions require reconciliation."
          },
          "403": {
            "description": "Operation held; unknown submissions require reconciliation."
          },
          "409": {
            "description": "Operation held; unknown submissions require reconciliation."
          },
          "422": {
            "description": "Operation held; unknown submissions require reconciliation."
          },
          "423": {
            "description": "Operation held; unknown submissions require reconciliation."
          },
          "503": {
            "description": "Operation held; unknown submissions require reconciliation."
          }
        }
      }
    },
