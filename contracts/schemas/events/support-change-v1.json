{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:multi-tenant:support-change:v1",
  "title": "SupportChangeV1",
  "description": "Restricted immutable support fact reference, never current authority. Re-fetch history through current owner authorization. At-least-once, unordered delivery.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_type": {
      "enum": [
        "support.security.granted",
        "support.security.revoked",
        "support.access.requested",
        "support.access.approved",
        "support.access.activated",
        "support.access.admitted",
        "support.access.denied",
        "support.access.rejected",
        "support.access.revoked",
        "support.access.expired",
        "support.access.invalidated",
        "support.access.reviewed"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "actor_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "resource_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "policy_version": {
      "const": 1
    },
    "audit_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "authority_use": {
      "const": "notification_only"
    }
  },
  "required": [
    "event_type",
    "schema_version",
    "event_id",
    "tenant_id",
    "actor_id",
    "resource_id",
    "revision",
    "correlation_id",
    "policy_version",
    "audit_sha256",
    "occurred_at",
    "authority_use"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "support.access.expired",
              "support.access.invalidated"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "actor_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    }
  ]
}
