{
  "openapi": "3.1.0",
  "info": {
    "title": "Worker migration stage boundary",
    "version": "2.1.0",
    "description": "Separate internal P07 worker component. Requires authenticated caller, current native grant authority, protected tooling and independent observer. The simulation API and inspection CLI do not expose this route."
  },
  "security": [
    {
      "Lifecycle": []
    }
  ],
  "paths": {
    "/internal/native-effects": {
      "post": {
        "operationId": "submitNativeSavedPlan",
        "description": "Execute an exact, independently resolved migration stage once under its bound grant. No caller-supplied tooling or evidence.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EffectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded submission receipt; no independent readiness or retry authority. Content-Length is mandatory and at most 4096 bytes.",
            "headers": {
              "Content-Length": {
                "required": true,
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EffectReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "423": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/internal/native-transfer-continuations": {
      "post": {
        "operationId": "continueImmutableNativeTransfer",
        "description": "Continue only a commissioned immutable image archive, under the original redeemed grant, checksum, exclusive spool lock, continuation count and absolute deadline. Never replay a native create or guest effect.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EffectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded submission receipt; no independent readiness or retry authority. Content-Length is mandatory and at most 4096 bytes.",
            "headers": {
              "Content-Length": {
                "required": true,
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4096
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EffectReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "423": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Denied or unavailable. An uncertain submission must be reconciled; no transport retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
