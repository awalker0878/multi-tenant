{
  "vhosts": [{"name": "product"}],
  "permissions": [
    {"user": "governance", "vhost": "product", "configure": "^$", "write": "^governance.events$", "read": "^$"},
    {"user": "console", "vhost": "product", "configure": "^$", "write": "^$", "read": "^console\\.governance$"}
  ],
  "exchanges": [{"name": "governance.events", "vhost": "product", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {}}],
  "queues": [{"name": "console.governance", "vhost": "product", "durable": true, "auto_delete": false, "arguments": {"x-queue-type": "quorum", "x-delivery-limit": -1}}],
  "bindings": [
    {"source": "governance.events", "vhost": "product", "destination": "console.governance", "destination_type": "queue", "routing_key": "governance.tenant.changed.v1", "arguments": {}},
    {"source": "governance.events", "vhost": "product", "destination": "console.governance", "destination_type": "queue", "routing_key": "governance.membership.changed.v1", "arguments": {}},
    {"source": "governance.events", "vhost": "product", "destination": "console.governance", "destination_type": "queue", "routing_key": "governance.grant.changed.v1", "arguments": {}},
    {"source": "governance.events", "vhost": "product", "destination": "console.governance", "destination_type": "queue", "routing_key": "governance.grant.revoked.v1", "arguments": {}},
    {"source": "governance.events", "vhost": "product", "destination": "console.governance", "destination_type": "queue", "routing_key": "governance.quota.changed.v1", "arguments": {}}
  ]
}
