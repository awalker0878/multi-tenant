      "kind",
      "scope",
      "route_sha256",
      "tranche_sha256",
      "release_sha256",
      "source",
      "target",
      "method",
      "api_compatibility",
      "native_e3_qualified",
      "receiving_e4_accepted",
      "status",
      "holds",
      "expires_at",
