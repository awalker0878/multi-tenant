{
  "openapi": "3.1.0",
  "info": {
    "title": "Governance plan-bound approvals",
    "version": "1.0.0",
    "description": "P02.04 policy v1: requestor and named executors cannot approve; exact action/scope/digest and live membership/grant revisions are bound. Decisions are observation_only, never native permits. Expiry becomes effective by time and is recorded once on protected retrieval/validation."
  },
  "security": [
    {
      "ConsoleWorkload": []
    }
  ],
  "paths": {
    "/v1/tenants/{tenant}/approvals": {
      "post": {
        "operationId": "requestApproval",
        "parameters": [
          {
            "in": "header",
            "name": "X-Console-Session",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "description": "Opaque server-held federated user session. Body actor/role values are never authority."
          },
          {
            "in": "path",
            "name": "tenant",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,128}$"
            },
            "description": "Same tenant/actor/command key and payload returns its committed receipt after current authority is rechecked; changed payload is 409."
          }
        ],
        "responses": {
          "201": {
            "description": "Success; Cache-Control: no-store, private",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalTransition"
                }
              }
            }
          },
          "401": {
            "description": "Invalid workload or user session"
          },
          "403": {
            "description": "Current scope/action denied"
          },
          "404": {
            "description": "Unknown resource or no membership"
          },
          "409": {
            "description": "Revision, retry, binding or transition conflict"
          },
          "422": {
            "description": "Invalid input"
          },
          "503": {
            "description": "Required authority unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "plan_id",
                  "plan_revision",
                  "plan_digest",
                  "expires_at"
                ],
                "properties": {
                  "plan_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "plan_revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "plan_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Future, at most 24 hours and no later than the plan validity."
                  }
                }
              }
            }
          }
        }
      }
    },
