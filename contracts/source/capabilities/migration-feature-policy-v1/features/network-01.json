      "target.network.segment",
      "owner.network.address_ownership",
      "owner.operations.dns_cutover",
      "source.ahv.network.nic_subnet",
      "source.openstack.network.port_project",
      "source.openstack.network.nic_binding",
      "target.openstack.target.network_extensions",
      "target.openstack.target.network_trunks",
      "source.openstack.network.declared_addresses",
      "target.openstack.target.network_dhcp",
      "target.ahv.target.subnet_external",
      "target.ahv.target.subnet_vpc"
    ],
    "operator_attributes": [
      "network.address_ownership",
      "operations.dns_cutover"
    ],
    "qualification": "unqualified",
